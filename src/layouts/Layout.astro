---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "AbdurRahman - Developer Portfolio", 
  image = "/og-image.jpg" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-dark.png" />
  </head>
  <body class="bg-cloud-surface text-tf-graphite font-sans antialiased selection:bg-signal-coral selection:text-white">
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:p-4 focus:bg-tf-graphite focus:text-white z-50">
      Skip to main content
    </a>

    <!-- Navbar -->
    <div class="fixed top-6 inset-x-0 z-50 flex justify-center px-6 pointer-events-none">
      <header class="pointer-events-auto bg-white/80 backdrop-blur-xl border border-gray-200/50 shadow-sm shadow-gray-200/20 rounded-full px-2 py-2 flex items-center justify-between gap-4 md:gap-8 transition-all animate-fade-in-up" style="animation-delay: 0.1s;">
        <a href="/" class="flex items-center pl-3 pr-2 md:pr-0">
          <img src="/logo-dark.png" alt="AbdurRahman Logo" class="h-7 md:h-8 w-auto object-contain" />
        </a>
        <nav class="hidden md:flex items-center gap-1 bg-gray-50/50 rounded-full p-1 border border-gray-100/50">
          <a href="/#about" class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-white px-4 py-1.5 rounded-full transition-all">About</a>
          <a href="/#services" class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-white px-4 py-1.5 rounded-full transition-all">Services</a>
          <a href="/#experience" class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-white px-4 py-1.5 rounded-full transition-all">Experience</a>
          <a href="/#skills" class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-white px-4 py-1.5 rounded-full transition-all">Skills</a>
        </nav>
        <a href="/#contact" class="px-5 py-2.5 bg-tf-graphite text-white text-[13px] font-bold tracking-wide rounded-full hover:bg-signal-coral transition-colors flex items-center gap-2">
          Let's Talk
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        </a>
      </header>
    </div>

    <main id="main-content" class="pt-32 min-h-screen">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-100 py-24 mt-32">
      <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8">
        <div class="md:col-span-5 lg:col-span-4">
          <a href="/" class="inline-block mb-6">
            <img src="/logo-dark.png" alt="AbdurRahman Logo" class="h-10 w-auto object-contain" />
          </a>
          <p class="text-gray-500 font-medium leading-relaxed mb-8 max-w-sm">Generative AI Engineer, Full-Stack Developer & Founder of Techily Fly.</p>
        </div>
        <div class="md:col-span-7 lg:col-span-8 grid grid-cols-2 md:grid-cols-3 gap-8">
          <div>
            <h4 class="font-bold mb-6 text-tf-graphite text-xs tracking-widest uppercase font-mono">Navigation</h4>
            <ul class="space-y-4">
              <li><a href="/#about" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">About</a></li>
              <li><a href="/#services" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Services</a></li>
              <li><a href="/#experience" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Experience</a></li>
              <li><a href="/#skills" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Skills</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold mb-6 text-tf-graphite text-xs tracking-widest uppercase font-mono">Connect</h4>
            <ul class="space-y-4">
              <li><a href="mailto:Contact@AbdurRahman.Top" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Email</a></li>
              <li><a href="https://linkedin.com/in/abdurrahmandottop" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">LinkedIn</a></li>
              <li><a href="https://x.com/AbdurRahmanDotT" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Twitter / X</a></li>
            </ul>
          </div>
          <div class="col-span-2 md:col-span-1">
            <h4 class="font-bold mb-6 text-tf-graphite text-xs tracking-widest uppercase font-mono">Legal</h4>
            <ul class="space-y-4">
              <li><a href="/privacy-policy" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Privacy Policy</a></li>
              <li><a href="/terms-conditions" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Terms</a></li>
              <li><a href="/disclaimer" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Disclaimer</a></li>
              <li><a href="/admin/login" class="text-gray-500 hover:text-signal-coral transition-colors text-sm font-semibold">Admin Login</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-6 mt-20 pt-8 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-4 text-[13px] text-gray-400 font-semibold">
        <p>&copy; {new Date().getFullYear()} AbdurRahman Dot Top. All rights reserved.</p>
        <p class="flex items-center gap-1">Designed with <span class="text-signal-coral">&hearts;</span></p>
      </div>
    </footer>
  </body>
</html>
