---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import BackToTop from '../components/BackToTop.astro';
import TawkWidget from '../components/TawkWidget.astro';
import Footer from '../components/Footer.astro';

import { eq, asc } from 'drizzle-orm';
import { getDb } from '../db';
import { socialLinks, siteSettings, menus } from '../db/schema';
import { env } from 'cloudflare:workers';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

// Default props (can be overridden by siteSettings)
const props = Astro.props;

let activeSocialLinks: any[] = [];
let globalSettings: Record<string, string> = {};
let activeMenus: any[] = [];

// Default fallback menus if DB is empty
const defaultMenus = [
  { id: 'about', title: 'About', url: '/#about', parentId: null, children: [] },
  { id: 'services', title: 'Services', url: '/#services', parentId: null, children: [] },
  { id: 'experience', title: 'Experience', url: '/#experience', parentId: null, children: [] },
  { id: 'skills', title: 'Skills', url: '/#skills', parentId: null, children: [] },
];
let structuredMenus: any[] = [];

try {
  const db = getDb(env.DB);
  
  // Fetch social links
  activeSocialLinks = await db.select().from(socialLinks).where(eq(socialLinks.isActive, true));
  
  // Fetch site settings
  const settingsDb = await db.select().from(siteSettings);
  settingsDb.forEach(s => {
    globalSettings[s.key] = s.value;
  });

  // Fetch menus
  activeMenus = await db.select().from(menus).where(eq(menus.isActive, true)).orderBy(asc(menus.order));
  
  // Build nested menu structure
  if (activeMenus.length > 0) {
    const parentMenus = activeMenus.filter(m => !m.parentId).map(m => ({ ...m, children: [] }));
    const childMenus = activeMenus.filter(m => m.parentId);
    
    childMenus.forEach(child => {
      const parent = parentMenus.find(p => p.id === child.parentId);
      if (parent) {
        parent.children.push(child);
      }
    });
    structuredMenus = parentMenus;
  } else {
    structuredMenus = defaultMenus;
  }

} catch (e) {
  console.error("Failed to fetch data for layout:", e);
}

// Compute final metadata (Props > Settings > Fallbacks)
const finalTitle = props.title || globalSettings['site_title'] || "AbdurRahman - Developer Portfolio";
const finalDescription = props.description || globalSettings['site_description'] || "AbdurRahman - AI Engineer & Full-Stack Developer Portfolio";
const finalImage = props.image || "/og-image.jpg";
const seoKeywords = globalSettings['seo_keywords'] || "ai, engineer, developer, fullstack, portfolio";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={seoKeywords} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={finalImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={finalTitle} />
    <meta property="twitter:description" content={finalDescription} />
    <meta property="twitter:image" content={finalImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo-dark.png" />
    
    <!-- Custom Head Scripts -->
    {globalSettings['custom_head_scripts'] && <Fragment set:html={globalSettings['custom_head_scripts']} />}
  </head>
  <body class="bg-cloud-surface text-tf-graphite font-sans antialiased selection:bg-signal-coral selection:text-white">
    <!-- Custom Body Scripts -->
    {globalSettings['custom_body_scripts'] && <Fragment set:html={globalSettings['custom_body_scripts']} />}
    
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:p-4 focus:bg-tf-graphite focus:text-white z-50">
      Skip to main content
    </a>

    <!-- Navbar -->
    <div class="fixed top-6 inset-x-0 z-50 flex justify-center px-6 pointer-events-none">
      <header class="pointer-events-auto bg-white/80 backdrop-blur-xl border border-gray-200/50 shadow-sm shadow-gray-200/20 rounded-full px-2 py-2 flex items-center justify-between w-full max-w-5xl transition-all animate-fade-in-up" style="animation-delay: 0.1s;">
        
        <div class="flex items-center md:hidden">
          <button id="mobile-nav-toggle" class="p-2 ml-1 text-gray-600 hover:text-signal-coral transition-colors rounded-full hover:bg-gray-100" aria-label="Toggle Menu">
            <svg id="mobile-nav-icon-menu" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="mobile-nav-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <a href="/" class="flex items-center px-2 md:pl-3 md:pr-0">
          <img src="/logo-dark.png" alt="AbdurRahman Logo" class="h-7 md:h-8 w-auto object-contain" />
        </a>
        
        <nav class="hidden md:flex items-center gap-1 bg-gray-50/50 rounded-full p-1 border border-gray-100/50">
          {structuredMenus.map((menu) => (
            <div class="relative group">
              <a href={menu.url} class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-white px-4 py-1.5 rounded-full transition-all flex items-center gap-1">
                {menu.icon && <div class="w-4 h-4" set:html={menu.icon} />}
                {menu.title}
                {menu.children.length > 0 && (
                  <svg class="w-3 h-3 text-gray-400 group-hover:text-tf-graphite transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                )}
              </a>
              
              {menu.children.length > 0 && (
                <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="bg-white/95 backdrop-blur-xl border border-gray-100 shadow-xl rounded-2xl py-2 min-w-[200px] flex flex-col gap-1">
                    {menu.children.map((child: any) => (
                      <a href={child.url} class="text-sm font-semibold text-gray-600 hover:text-tf-graphite hover:bg-gray-50 px-4 py-2 mx-2 rounded-xl transition-all flex items-center gap-2">
                        {child.icon && <div class="w-4 h-4 text-signal-coral" set:html={child.icon} />}
                        {child.title}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </nav>
        
        <a href="/#contact" class="px-5 py-2.5 bg-tf-graphite text-white text-[13px] font-bold tracking-wide rounded-full hover:bg-signal-coral transition-colors flex items-center gap-2 shrink-0">
          Let's Talk
          <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        </a>
      </header>
    </div>

    <!-- Mobile Nav Dropdown -->
    <div id="mobile-nav-dropdown" class="fixed top-24 left-6 right-6 z-40 bg-white/95 backdrop-blur-xl border border-gray-200 shadow-xl rounded-2xl p-4 flex flex-col gap-2 transform -translate-y-4 opacity-0 pointer-events-none transition-all duration-300 md:hidden max-h-[70vh] overflow-y-auto">
      {structuredMenus.map((menu) => (
        <div class="flex flex-col">
          <a href={menu.url} class="mobile-nav-link text-base font-semibold text-gray-600 hover:text-tf-graphite hover:bg-gray-50 px-4 py-3 rounded-xl transition-all flex items-center justify-between">
            <span class="flex items-center gap-2">
              {menu.icon && <div class="w-5 h-5" set:html={menu.icon} />}
              {menu.title}
            </span>
          </a>
          
          {menu.children.length > 0 && (
            <div class="pl-6 pr-2 py-1 flex flex-col gap-1 border-l-2 border-gray-100 ml-6 mt-1">
              {menu.children.map((child: any) => (
                <a href={child.url} class="mobile-nav-link text-sm font-semibold text-gray-500 hover:text-signal-coral hover:bg-red-50/50 px-4 py-2.5 rounded-xl transition-all flex items-center gap-2">
                  {child.icon && <div class="w-4 h-4 text-signal-coral" set:html={child.icon} />}
                  {child.title}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    <main id="main-content" class="pt-32 min-h-screen">
      <slot />
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('mobile-nav-toggle');
        const dropdown = document.getElementById('mobile-nav-dropdown');
        const iconMenu = document.getElementById('mobile-nav-icon-menu');
        const iconClose = document.getElementById('mobile-nav-icon-close');
        const links = document.querySelectorAll('.mobile-nav-link');

        function toggleMobileMenu() {
          if (!dropdown) return;
          const isOpen = dropdown.classList.contains('pointer-events-auto');
          
          if (isOpen) {
            dropdown.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            dropdown.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
            iconMenu?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
          } else {
            dropdown.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
            dropdown.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
            iconMenu?.classList.add('hidden');
            iconClose?.classList.remove('hidden');
          }
        }

        toggleBtn?.addEventListener('click', toggleMobileMenu);

        links.forEach(link => {
          link.addEventListener('click', () => {
            if (dropdown && dropdown.classList.contains('pointer-events-auto')) {
              toggleMobileMenu();
            }
          });
        });
        
        document.addEventListener('click', (e) => {
          if (dropdown && toggleBtn && !dropdown.contains(e.target as Node) && !toggleBtn.contains(e.target as Node) && dropdown.classList.contains('pointer-events-auto')) {
            toggleMobileMenu();
          }
        });
      });
    </script>

    <Footer />

    <!-- Right Side Social Bar -->
    <div class="hidden xl:flex fixed right-6 top-1/2 -translate-y-1/2 flex-col items-center gap-6 z-40">
      <div class="w-[1px] h-24 bg-gray-200"></div>
      
      {activeSocialLinks.length > 0 ? (
        activeSocialLinks.map(link => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform} class="text-gray-400 hover:text-signal-coral transition-all hover:-translate-x-1 group" title={link.platform}>
            {link.icon ? (
              <div class="h-5 w-5 opacity-70 group-hover:opacity-100 transition-opacity" set:html={link.icon} />
            ) : (
              <span class="font-bold text-xs uppercase tracking-wider group-hover:underline" style="writing-mode: vertical-rl; text-orientation: mixed;">{link.platform}</span>
            )}
          </a>
        ))
      ) : (
        <>
          <a href="https://linkedin.com/in/abdurrahmandottop" target="_blank" class="text-gray-400 hover:text-signal-coral transition-all hover:-translate-x-1" title="LinkedIn">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5 opacity-70 hover:opacity-100" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
          </a>
          <a href="https://x.com/AbdurRahmanDotT" target="_blank" class="text-gray-400 hover:text-signal-coral transition-all hover:-translate-x-1" title="Twitter">
            <span class="sr-only">Twitter</span>
            <svg class="h-5 w-5 opacity-70 hover:opacity-100" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" /></svg>
          </a>
        </>
      )}
      
      <div class="w-[1px] h-24 bg-gray-200"></div>
    </div>

    <BackToTop />
    <TawkWidget />
  </body>
</html>
