---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | AbdurRahman">
  <section class="min-h-[80vh] flex flex-col justify-center items-center px-4 relative overflow-hidden">
    <!-- Background Accents -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg aspect-square bg-signal-coral/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-gray-100/50 rounded-full blur-3xl -z-10 pointer-events-none"></div>

    <div class="text-center relative z-10 animate-fade-in-up">
      <!-- Glitch effect or stylized text for 404 -->
      <h1 class="text-8xl md:text-[12rem] font-black text-transparent bg-clip-text bg-gradient-to-br from-tf-graphite to-gray-400 leading-none select-none mb-6">
        404
      </h1>
      
      <h2 class="text-2xl md:text-4xl font-bold text-tf-graphite mb-4 tracking-tight">
        Oops! You're lost in space.
      </h2>
      
      <p class="text-gray-500 font-medium max-w-md mx-auto mb-10 text-lg md:text-xl">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>

      <a href="/" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-tf-graphite rounded-full hover:bg-signal-coral transition-all shadow-xl shadow-tf-graphite/10 hover:shadow-signal-coral/20 hover:-translate-y-1 group">
        <svg class="w-5 h-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Homepage
      </a>
    </div>
  </section>
</Layout>
