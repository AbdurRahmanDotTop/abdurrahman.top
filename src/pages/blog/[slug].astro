---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { blogPosts } from '../../db/schema';

const { slug } = Astro.params;

const locals = Astro.locals as any;
const env = locals.runtime?.env;

if (!slug) {
  return Astro.redirect('/404');
}

const db = getDb(env.DB);
const [post] = await db.select()
  .from(blogPosts)
  .where(eq(blogPosts.slug, slug))
  .limit(1);

if (!post || !post.isPublished) {
  return Astro.redirect('/404');
}
---

<Layout title={`${post.title} - Techily Fly Blog`} description={post.excerpt || undefined} image={post.featuredImage || undefined}>
  <article class="max-w-3xl mx-auto px-6 py-24 bg-white rounded-xl shadow-sm my-12 border border-gray-100">
    <header class="mb-12 text-center">
      <time class="text-sm font-semibold text-signal-coral tracking-wider uppercase mb-4 block">
        {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'Draft'}
      </time>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6 leading-tight">{post.title}</h1>
    </header>

    {post.featuredImage && (
      <div class="mb-12 rounded-2xl overflow-hidden shadow-lg">
        <img src={post.featuredImage} alt={post.title} class="w-full object-cover" />
      </div>
    )}

    <div class="prose max-w-none prose-lg text-gray-700">
      <!-- Since content is stored as HTML/Markdown string in DB, for this iteration we'll assume it's pre-rendered HTML -->
      <Fragment set:html={post.content} />
    </div>
  </article>
</Layout>
