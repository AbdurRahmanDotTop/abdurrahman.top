---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { eq, desc } from 'drizzle-orm';
import { getDb } from '../../db';
import { blogPosts } from '../../db/schema';

import { env } from "cloudflare:workers";
const db = getDb(env.DB);
const posts = await db.select()
  .from(blogPosts)
  .where(eq(blogPosts.isPublished, true))
  .orderBy(desc(blogPosts.publishedAt));
---

<Layout title="Blog - Techily Fly">
  <div class="max-w-4xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <span class="text-signal-coral font-bold tracking-wider uppercase text-sm">Insights</span>
      <h1 class="text-4xl font-bold mt-2">Latest Articles</h1>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-100">
        <p class="text-gray-500">No blog posts published yet. Check back soon!</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-8">
        {posts.map((post) => (
          <article class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-8 hover:shadow-md transition-shadow">
            {post.featuredImage && (
              <div class="md:w-1/3 shrink-0">
                <img src={post.featuredImage} alt={post.title} class="w-full h-48 object-cover rounded-xl" />
              </div>
            )}
            <div class="flex-1 flex flex-col justify-center">
              <time class="text-sm font-medium text-gray-500 mb-2">
                {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : 'Draft'}
              </time>
              <h2 class="text-2xl font-bold mb-3 hover:text-signal-coral transition-colors">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="text-gray-600 mb-6 line-clamp-3">
                {post.excerpt}
              </p>
              <div class="mt-auto">
                <a href={`/blog/${post.slug}`} class="text-signal-coral font-semibold hover:underline">Read Article →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
