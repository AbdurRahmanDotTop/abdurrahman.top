          {sec.title}
        </h3>
        
        <form method="POST" class="space-y-6">
          <input type="hidden" name="id" value={sec.id} />
          
          <!-- Hidden input that will hold the Alpine JSON state on submit -->
          <input type="hidden" name="content" :value="JSON.stringify(parsed)" />
          
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Section Title (Internal)</label>
