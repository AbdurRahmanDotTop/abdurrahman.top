                     <label class="block text-sm font-bold text-gray-700 mb-2">Heading (HTML Allowed)</label>
                     <textarea x-model="parsed.heading" rows="3" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed"></textarea>
                   </div>
