---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { sections } from '../../db/schema';
import AdminLayout from '../../layouts/AdminLayout.astro';

const locals = Astro.locals as any;
const env = locals.runtime?.env;

const db = getDb(env.DB);

// Pre-fill some default sections if empty
let allSections = await db.select().from(sections).orderBy(sections.order);
if (allSections.length === 0) {
  const defaults = [
    { id: crypto.randomUUID(), sectionId: 'hero', title: 'Hero Section', content: '{"heading":"I am AbdurRahman", "subheading":"Developer"}' },
    { id: crypto.randomUUID(), sectionId: 'about', title: 'About Me', content: '{"text":"Passionate developer..."}' },
    { id: crypto.randomUUID(), sectionId: 'experience', title: 'Experience', content: '[]' },
    { id: crypto.randomUUID(), sectionId: 'projects', title: 'Projects', content: '[]' },
  ];
  await db.insert(sections).values(defaults);
  allSections = await db.select().from(sections).orderBy(sections.order);
}

let message = '';
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const sectionId = data.get('id') as string;
    const title = data.get('title') as string;
    const content = data.get('content') as string;
    const isActive = data.get('isActive') === 'on';

    if (sectionId) {
      await db.update(sections)
        .set({ title, content, isActive })
        .where(eq(sections.id, sectionId));
      message = 'Section updated successfully.';
    }
    // reload data
    return Astro.redirect('/admin/sections');
  } catch (e: any) {
    message = e.message || 'Error updating section.';
  }
}
---

<AdminLayout title="Manage Sections" currentPath="/admin/sections">
  <header class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Manage Sections</h1>
      <p class="text-gray-500 mt-2">Update the content of your portfolio sections.</p>
    </div>
  </header>

  {message && <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl font-medium">{message}</div>}

  <div class="space-y-6">
    {allSections.map((sec) => (
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
        <h3 class="text-xl font-bold mb-6 capitalize flex items-center gap-2">
          <svg class="w-5 h-5 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          {sec.title}
        </h3>
        
        <form method="POST" class="space-y-6">
          <input type="hidden" name="id" value={sec.id} />
          
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Section Title</label>
            <input type="text" name="title" value={sec.title} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2 flex justify-between">
              <span>Content Data</span>
              <span class="text-xs text-gray-400 font-normal bg-gray-100 px-2 py-0.5 rounded">JSON / Text</span>
            </label>
            <textarea name="content" rows="6" class="w-full px-4 py-3 bg-gray-900 text-gray-100 border border-gray-200 rounded-xl font-mono text-sm focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all leading-relaxed">{sec.content}</textarea>
          </div>

          <div class="flex items-center gap-3 bg-gray-50 p-4 rounded-xl border border-gray-100">
            <input type="checkbox" name="isActive" id={`active-${sec.id}`} checked={sec.isActive ?? false} class="w-5 h-5 text-signal-coral rounded focus:ring-signal-coral border-gray-300" />
            <label for={`active-${sec.id}`} class="text-sm font-bold text-gray-700 cursor-pointer select-none">Is Active (Visible on site)</label>
          </div>

          <div class="pt-2">
            <button type="submit" class="px-6 py-3 bg-tf-graphite text-white font-bold rounded-xl hover:bg-black transition-colors flex items-center gap-2 shadow-lg shadow-black/10">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
              Save {sec.title}
            </button>
          </div>
        </form>
      </div>
    ))}
  </div>
</AdminLayout>
