---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { sections } from '../../db/schema';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);

// Pre-fill some default sections if empty
let allSections = await db.select().from(sections).orderBy(sections.order);
if (allSections.length === 0) {
  const defaults = [
    { id: crypto.randomUUID(), sectionId: 'hero', title: 'Hero Section', content: '{"heading":"I am AbdurRahman", "subheading":"Developer"}' },
    { id: crypto.randomUUID(), sectionId: 'about', title: 'About Me', content: '{"text":"Passionate developer..."}' },
    { id: crypto.randomUUID(), sectionId: 'experience', title: 'Experience', content: '[]' },
    { id: crypto.randomUUID(), sectionId: 'projects', title: 'Projects', content: '[]' },
  ];
  await db.insert(sections).values(defaults);
  allSections = await db.select().from(sections).orderBy(sections.order);
}

let message = '';
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const sectionId = data.get('id') as string;
    const sectionType = data.get('section_type') as string;
    const title = data.get('title') as string;
    const isActive = data.get('isActive') === 'on';

    let content = '';

    if (sectionType === 'hero') {
      content = JSON.stringify({
        heading: data.get('hero_heading') as string,
        subheading: data.get('hero_subheading') as string,
        imageUrl: data.get('hero_image_url') as string,
        badge: data.get('hero_badge') as string,
      });
    } else if (sectionType === 'about') {
      content = JSON.stringify({
        heading: data.get('about_heading') as string,
        imageUrl: data.get('about_image_url') as string,
        text: data.get('about_text') as string,
      });
    } else {
      // Fallback for others (Experience, Projects) if not updated yet
      content = data.get('content') as string;
    }

    if (sectionId) {
      await db.update(sections)
        .set({ title, content, isActive })
        .where(eq(sections.id, sectionId));
      message = 'Section updated successfully.';
    }
    // reload data
    return Astro.redirect('/admin/sections');
  } catch (e: any) {
    message = e.message || 'Error updating section.';
  }
}
---

<AdminLayout title="Manage Sections" currentPath="/admin/sections">
  <header class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Manage Sections</h1>
      <p class="text-gray-500 mt-2">Update the content of your portfolio sections.</p>
    </div>
  </header>

  {message && <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl font-medium">{message}</div>}

  <div class="space-y-6">
    {allSections.map((sec) => (
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
        <h3 class="text-xl font-bold mb-6 capitalize flex items-center gap-2">
          <svg class="w-5 h-5 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          {sec.title}
        </h3>
        
        <form method="POST" class="space-y-6">
          <input type="hidden" name="id" value={sec.id} />
          <input type="hidden" name="section_type" value={sec.sectionId} />
          
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Section Title (Internal)</label>
            <input type="text" name="title" value={sec.title} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
          </div>

          <div class="pt-2 border-t border-gray-100 mt-6">
            <h4 class="text-sm font-bold text-tf-graphite mb-4 uppercase tracking-wider">Content Settings</h4>
            
            {(() => {
              let parsed: any = {};
              try { parsed = JSON.parse(sec.content || '{}'); } catch(e){}

              if (sec.sectionId === 'hero') {
                return (
                  <div class="space-y-5">
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Heading (HTML Allowed)</label>
                      <textarea name="hero_heading" rows="3" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="Salaam, I'm <br><span class='text-signal-coral'>AbdurRahman.</span>">{parsed.heading || ''}</textarea>
                    </div>
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Subheading</label>
                      <textarea name="hero_subheading" rows="3" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="A multi-disciplinary Generative AI Engineer...">{parsed.subheading || ''}</textarea>
                    </div>
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Profile Image URL</label>
                      <input type="url" name="hero_image_url" value={parsed.imageUrl || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="https://..." />
                    </div>
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Status Badge</label>
                      <input type="text" name="hero_badge" value={parsed.badge || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="Available for new opportunities" />
                    </div>
                  </div>
                );
              } else if (sec.sectionId === 'about') {
                return (
                  <div class="space-y-5">
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Heading (HTML Allowed)</label>
                      <textarea name="about_heading" rows="3" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="Transforming Ideas into...">{parsed.heading || ''}</textarea>
                    </div>
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">Image URL</label>
                      <input type="url" name="about_image_url" value={parsed.imageUrl || ''} class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" placeholder="https://..." />
                    </div>
                    <div>
                      <label class="block text-sm font-bold text-gray-700 mb-2">About Content (Markdown/Text)</label>
                      <textarea name="about_text" rows="8" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed" placeholder="Passionate developer...">{parsed.text || ''}</textarea>
                    </div>
                  </div>
                );
              } else {
                return (
                  <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 flex justify-between">
                      <span>Raw Data</span>
                      <span class="text-xs text-gray-400 font-normal bg-gray-100 px-2 py-0.5 rounded">JSON</span>
                    </label>
                    <textarea name="content" rows="6" class="w-full px-4 py-3 bg-gray-900 text-gray-100 border border-gray-200 rounded-xl font-mono text-sm focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all leading-relaxed">{sec.content}</textarea>
                  </div>
                );
              }
            })()}
          </div>

          <div class="flex items-center gap-3 bg-gray-50 p-4 rounded-xl border border-gray-100 mt-6">
            <input type="checkbox" name="isActive" id={`active-${sec.id}`} checked={sec.isActive ?? false} class="w-5 h-5 text-signal-coral rounded focus:ring-signal-coral border-gray-300" />
            <label for={`active-${sec.id}`} class="text-sm font-bold text-gray-700 cursor-pointer select-none">Is Active (Visible on site)</label>
          </div>

          <div class="pt-2">
            <button type="submit" class="px-6 py-3 bg-tf-graphite text-white font-bold rounded-xl hover:bg-black transition-colors flex items-center gap-2 shadow-lg shadow-black/10">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
              Save {sec.title}
            </button>
          </div>
        </form>
      </div>
    ))}
  </div>
</AdminLayout>
