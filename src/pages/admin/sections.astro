let allSections = await db.select().from(sections).orderBy(sections.order);
if (allSections.length === 0) {
  await db.insert(sections).values(defaultData);
  allSections = await db.select().from(sections).orderBy(sections.order);
}

// Add missing sections if user already had some data but not all
const existingIds = allSections.map(s => s.sectionId);
const missingData = defaultData.filter(d => !existingIds.includes(d.sectionId));
if(missingData.length > 0) {
    await db.insert(sections).values(missingData);
    allSections = await db.select().from(sections).orderBy(sections.order);
}


let message = '';
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const sectionId = data.get('id') as string;
    const title = data.get('title') as string;
    const isActive = data.get('isActive') === 'on';
    const content = data.get('content') as string;

    if (sectionId && content) {
      // Validate JSON to prevent crashes on frontend
      JSON.parse(content);

      await db.update(sections)
        .set({ title, content, isActive })
        .where(eq(sections.id, sectionId));
      message = 'Section updated successfully.';
    }
    return Astro.redirect('/admin/sections');
  } catch (e: any) {
    message = e.message || 'Error updating section.';
  }
}
---

<AdminLayout title="Manage Sections" currentPath="/admin/sections">
  <header class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Manage Sections</h1>
      <p class="text-gray-500 mt-2">Update the content of your portfolio sections. (Fully Dynamic Architecture)</p>
    </div>
  </header>

  {message && <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl font-medium">{message}</div>}

  <div class="space-y-6">
    {allSections.map((sec) => (
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60" x-data={`{ parsed: JSON.parse($el.dataset.content || '{}') }`} data-content={sec.content}>
