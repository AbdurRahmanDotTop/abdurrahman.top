                   </div>
                   <div>
                     <label class="block text-sm font-bold text-gray-700 mb-2">Status Badge</label>
                     <input type="text" x-model="parsed.badge" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
