                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Icon (SVG Code)</label>
                                  <input type="text" x-model="item.icon" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none font-mono" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Description</label>
                                  <textarea x-model="item.description" rows="2" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none"></textarea>
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Column Span (Tailwind)</label>
                                  <input type="text" x-model="item.colSpan" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Accent Background</label>
                                  <input type="text" x-model="item.accent" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                              </div>
                           </div>
                        </template>
                        <div x-show="!parsed.items || parsed.items.length === 0" class="text-gray-400 text-sm italic">No items yet.</div>
                     </div>
                   </div>
               </div>
            )}

            {/* SKILLS UI */}
            {sec.sectionId === 'skills' && (
               <div class="space-y-6">
                   <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Heading</label>
                       <input type="text" x-model="parsed.heading" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
                     </div>
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Subheading</label>
                       <textarea x-model="parsed.subheading" rows="2" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed"></textarea>
                     </div>
                   </div>
                   
                   <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                     <h5 class="font-bold text-tf-graphite mb-4 flex justify-between items-center">
                        Skill Categories
                        <button type="button" @click="parsed.categories = parsed.categories || []; parsed.categories.push({category:'', items:''})" class="text-sm px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100">+ Add Category</button>
                     </h5>
                     <div class="space-y-4">
                        <template x-for="(cat, index) in parsed.categories" :key="index">
                           <div class="bg-white p-4 border border-gray-200 rounded-lg relative pr-10">
                              <button type="button" @click="parsed.categories.splice(index, 1)" class="absolute top-4 right-4 text-red-500 hover:text-red-700 font-bold text-xl">&times;</button>
                              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Category Title</label>
                                  <input type="text" x-model="cat.category" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Items (Comma separated)</label>
                                  <input type="text" x-model="cat.items" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                              </div>
                           </div>
                        </template>
                        <div x-show="!parsed.categories || parsed.categories.length === 0" class="text-gray-400 text-sm italic">No categories yet.</div>
                     </div>
                   </div>
               </div>
            )}

            {/* EXPERIENCE UI */}
            {sec.sectionId === 'experience' && (
               <div class="space-y-6">
                   <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Heading</label>
                       <input type="text" x-model="parsed.heading" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
                     </div>
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Subheading</label>
                       <textarea x-model="parsed.subheading" rows="2" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed"></textarea>
                     </div>
                   </div>
                   
                   <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                     <h5 class="font-bold text-tf-graphite mb-4 flex justify-between items-center">
                        Timeline Items (Experience, Education, etc)
                        <button type="button" @click="parsed.items = parsed.items || []; parsed.items.push({role:'', company:'', date:'', type:'Experience', description:'', tags:''})" class="text-sm px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100">+ Add Item</button>
                     </h5>
                     <div class="space-y-4">
                        <template x-for="(item, index) in parsed.items" :key="index">
                           <div class="bg-white p-4 border border-gray-200 rounded-lg relative pr-10">
                              <button type="button" @click="parsed.items.splice(index, 1)" class="absolute top-4 right-4 text-red-500 hover:text-red-700 font-bold text-xl">&times;</button>
                              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Role / Degree Title</label>
                                  <input type="text" x-model="item.role" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Company / Institution</label>
                                  <input type="text" x-model="item.company" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Date String (e.g. 2017 — 2020)</label>
                                  <input type="text" x-model="item.date" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Type (Experience, Education, etc)</label>
                                  <input type="text" x-model="item.type" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Description</label>
                                  <textarea x-model="item.description" rows="2" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none"></textarea>
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Tags (Comma separated - optional)</label>
                                  <input type="text" x-model="item.tags" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                              </div>
                           </div>
                        </template>
                        <div x-show="!parsed.items || parsed.items.length === 0" class="text-gray-400 text-sm italic">No items yet.</div>
                     </div>
                   </div>

                   <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 mt-6">
                     <h5 class="font-bold text-tf-graphite mb-4">Credentials Section Meta</h5>
                     <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
                       <div class="md:col-span-2">
                         <label class="block text-sm font-bold text-gray-700 mb-2">Heading</label>
                         <input type="text" x-model="parsed.credentialsHeading" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
                       </div>
                       <div class="md:col-span-2">
                         <label class="block text-sm font-bold text-gray-700 mb-2">Subheading</label>
                         <textarea x-model="parsed.credentialsSubheading" rows="2" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed"></textarea>
                       </div>
                     </div>

                     <h5 class="font-bold text-tf-graphite mb-4 flex justify-between items-center">
                        Verified Credentials
                        <button type="button" @click="parsed.credentials = parsed.credentials || []; parsed.credentials.push({typeLabel:'CERTIFICATE', title:'', issuer:'', issuedDate:'', link:''})" class="text-sm px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100">+ Add Credential</button>
                     </h5>
                     <div class="space-y-4">
                        <template x-for="(cred, index) in parsed.credentials" :key="index">
                           <div class="bg-white p-4 border border-gray-200 rounded-lg relative pr-10">
                              <button type="button" @click="parsed.credentials.splice(index, 1)" class="absolute top-4 right-4 text-red-500 hover:text-red-700 font-bold text-xl">&times;</button>
                              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Type Label (e.g. DIPLOMA)</label>
                                  <input type="text" x-model="cred.typeLabel" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Title</label>
                                  <input type="text" x-model="cred.title" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Issuer</label>
                                  <input type="text" x-model="cred.issuer" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Issued Date (e.g. 2020)</label>
                                  <input type="text" x-model="cred.issuedDate" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Link (Optional)</label>
                                  <input type="text" x-model="cred.link" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                              </div>
                           </div>
                        </template>
                        <div x-show="!parsed.credentials || parsed.credentials.length === 0" class="text-gray-400 text-sm italic">No credentials yet.</div>
                     </div>
                   </div>
               </div>
            )}

            {/* PORTFOLIO UI */}
            {sec.sectionId === 'portfolio' && (
               <div class="space-y-6">
                   <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Heading</label>
                       <input type="text" x-model="parsed.heading" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
                     </div>
                     <div class="md:col-span-2">
                       <label class="block text-sm font-bold text-gray-700 mb-2">Subheading</label>
                       <textarea x-model="parsed.subheading" rows="2" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium leading-relaxed"></textarea>
                     </div>
                   </div>
                   
                   <div class="bg-gray-50 border border-gray-200 rounded-xl p-4">
                     <h5 class="font-bold text-tf-graphite mb-4 flex justify-between items-center">
                        Project Cards
                        <button type="button" @click="parsed.items = parsed.items || []; parsed.items.push({title:'', description:'', featuredImage:'', skills:'', liveUrl:''})" class="text-sm px-3 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100">+ Add Project</button>
                     </h5>
                     <div class="space-y-4">
                        <template x-for="(item, index) in parsed.items" :key="index">
                           <div class="bg-white p-4 border border-gray-200 rounded-lg relative pr-10">
                              <button type="button" @click="parsed.items.splice(index, 1)" class="absolute top-4 right-4 text-red-500 hover:text-red-700 font-bold text-xl">&times;</button>
                              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Project Title</label>
                                  <input type="text" x-model="item.title" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div>
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Live Project URL</label>
                                  <input type="text" x-model="item.liveUrl" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Featured Image URL</label>
                                  <input type="text" x-model="item.featuredImage" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Description</label>
                                  <textarea x-model="item.description" rows="2" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none"></textarea>
                                </div>
                                <div class="md:col-span-2">
                                  <label class="block text-xs font-bold text-gray-500 mb-1">Skills / Technologies (Comma separated)</label>
                                  <input type="text" x-model="item.skills" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded text-sm focus:ring-1 focus:ring-signal-coral outline-none" />
                                </div>
                              </div>
                           </div>
                        </template>
                        <div x-show="!parsed.items || parsed.items.length === 0" class="text-gray-400 text-sm italic">No projects yet.</div>
                     </div>
                   </div>
               </div>
            )}
          </div>

          <div class="flex items-center gap-3 bg-gray-50 p-4 rounded-xl border border-gray-100 mt-6">
            <input type="checkbox" name="isActive" id={`active-${sec.id}`} checked={sec.isActive ?? false} class="w-5 h-5 text-signal-coral rounded focus:ring-signal-coral border-gray-300" />
            <label for={`active-${sec.id}`} class="text-sm font-bold text-gray-700 cursor-pointer select-none">Is Active (Visible on site)</label>
          </div>

          <div class="pt-2">
            <button type="submit" class="px-6 py-3 bg-tf-graphite text-white font-bold rounded-xl hover:bg-black transition-colors flex items-center gap-2 shadow-lg shadow-black/10">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" /></svg>
              Save {sec.title}
            </button>
          </div>
        </form>
      </div>
    ))}
  </div>
</AdminLayout>
