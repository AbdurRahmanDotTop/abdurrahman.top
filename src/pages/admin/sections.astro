                   </div>
                   <h5 class="md:col-span-2 font-bold text-tf-graphite mt-4 border-b border-gray-100 pb-2">Bento Box Details</h5>
                   <div>
                     <label class="block text-sm font-bold text-gray-700 mb-2">Bento Label</label>
                     <input type="text" x-model="parsed.bentoLabel" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
                   </div>
