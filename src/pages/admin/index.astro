---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard" currentPath="/admin">
  <header class="mb-8">
    <h1 class="text-3xl font-bold">Dashboard Overview</h1>
    <p class="text-gray-500 mt-2">Welcome back. Manage your portfolio and blog content from here.</p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all">
      <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
      </div>
      <h3 class="text-lg font-bold mb-2">Inquiries</h3>
      <p class="text-gray-500 text-sm mb-4 leading-relaxed">View contact form submissions and lead messages.</p>
      <a href="/admin/inquiries" class="text-signal-coral font-bold text-sm hover:underline flex items-center gap-1">Manage Inquiries <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></a>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all">
      <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center text-purple-600 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
      </div>
      <h3 class="text-lg font-bold mb-2">Sections</h3>
      <p class="text-gray-500 text-sm mb-4 leading-relaxed">Edit Hero, About, Services, and structural pages.</p>
      <a href="/admin/sections" class="text-signal-coral font-bold text-sm hover:underline flex items-center gap-1">Manage Sections <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></a>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all">
      <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
      </div>
      <h3 class="text-lg font-bold mb-2">Socials & CV</h3>
      <p class="text-gray-500 text-sm mb-4 leading-relaxed">Manage your Linktree profiles, CV, and hero links.</p>
      <a href="/admin/links" class="text-signal-coral font-bold text-sm hover:underline flex items-center gap-1">Manage Socials <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></a>
    </div>
    
    <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-all">
      <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600 mb-4">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15M9 11l3 3m0 0l3-3m-3 3V8" /></svg>
      </div>
      <h3 class="text-lg font-bold mb-2">Blog Posts</h3>
      <p class="text-gray-500 text-sm mb-4 leading-relaxed">Write, edit, and publish new articles.</p>
      <a href="/admin/blog" class="text-signal-coral font-bold text-sm hover:underline flex items-center gap-1">Manage Blog <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></a>
    </div>
  </div>
</AdminLayout>
