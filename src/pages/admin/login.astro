---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { users } from '../../db/schema';
import { verifyPassword, hashPassword, createSessionCookie } from '../../lib/auth';

let errorMessage = '';
let isFirstSetup = false;

const locals = Astro.locals as any;
const env = locals.runtime?.env;
const db = getDb(env.DB);
const existingUsers = await db.select().from(users).limit(1);

if (existingUsers.length === 0) {
  isFirstSetup = true;
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email');
    const password = data.get('password');

    if (typeof email !== 'string' || typeof password !== 'string') {
      throw new Error('Invalid form data');
    }

    if (isFirstSetup) {
      // Create first admin user
      const passwordHash = await hashPassword(password);
      const userId = crypto.randomUUID();
      
      await db.insert(users).values({
        id: userId,
        email,
        passwordHash,
        createdAt: new Date(),
      });

      const token = await createSessionCookie(userId);
      Astro.cookies.set('admin_session', token, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7 });
      
      return Astro.redirect('/admin');
    } else {
      // Regular login
      const [user] = await db.select().from(users).where(eq(users.email, email)).limit(1);
      
      if (!user) {
        errorMessage = 'Invalid email or password';
      } else {
        const isValid = await verifyPassword(password, user.passwordHash);
        if (isValid) {
          const token = await createSessionCookie(user.id);
          Astro.cookies.set('admin_session', token, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7 });
          return Astro.redirect('/admin');
        } else {
          errorMessage = 'Invalid email or password';
        }
      }
    }
  } catch (e: any) {
    errorMessage = e.message || 'An error occurred';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isFirstSetup ? 'Admin Setup' : 'Admin Login'} - Techily Fly</title>
    <link href="/src/styles/global.css" rel="stylesheet" />
  </head>
  <body class="bg-[#f8fafc] text-tf-graphite min-h-screen flex items-center justify-center font-sans p-4">
    <div class="w-full max-w-md p-8 md:p-10 bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
      <div class="mb-10 text-center">
        <h1 class="text-3xl font-extrabold mb-3 tracking-tight">{isFirstSetup ? 'Admin Setup' : 'Welcome Back'}</h1>
        <p class="text-gray-500 text-sm font-medium">
          {isFirstSetup ? 'Create your first admin account to get started.' : 'Enter your credentials to access the dashboard.'}
        </p>
      </div>

      {errorMessage && (
        <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-xl text-sm font-bold border border-red-100 flex items-center gap-2">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          {errorMessage}
        </div>
      )}

      <form method="POST" class="space-y-6">
        <div>
          <label for="email" class="block text-sm font-bold text-gray-700 mb-2">Email or Username</label>
          <input 
            type="text" 
            id="email" 
            name="email" 
            required
            class="w-full px-5 py-3.5 bg-gray-50 rounded-xl border border-gray-200 focus:border-transparent focus:bg-white focus:ring-2 focus:ring-signal-coral outline-none transition-all font-medium"
            placeholder="admin@example.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-bold text-gray-700 mb-2">Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required
            class="w-full px-5 py-3.5 bg-gray-50 rounded-xl border border-gray-200 focus:border-transparent focus:bg-white focus:ring-2 focus:ring-signal-coral outline-none transition-all font-medium"
            placeholder="••••••••"
          />
        </div>

        <button 
          type="submit" 
          class="w-full py-4 px-6 bg-tf-graphite hover:bg-black text-white font-bold rounded-xl transition-all shadow-lg shadow-black/10 flex justify-center items-center gap-2 mt-4"
        >
          {isFirstSetup ? 'Create Account' : 'Sign In'}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </button>
      </form>
    </div>
  </body>
</html>
