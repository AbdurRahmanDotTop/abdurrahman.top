---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { users } from '../../db/schema';
import { verifyPassword, hashPassword, createSessionCookie } from '../../lib/auth';

let errorMessage = '';
let isFirstSetup = false;

import { env } from "cloudflare:workers";
const db = getDb(env.DB);
const existingUsers = await db.select().from(users).limit(1);

if (existingUsers.length === 0) {
  isFirstSetup = true;
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email');
    const password = data.get('password');

    if (typeof email !== 'string' || typeof password !== 'string') {
      throw new Error('Invalid form data');
    }

    if (isFirstSetup) {
      // Create first admin user
      const passwordHash = await hashPassword(password);
      const userId = crypto.randomUUID();
      
      await db.insert(users).values({
        id: userId,
        email,
        passwordHash,
        createdAt: new Date(),
      });

      const token = await createSessionCookie(userId);
      Astro.cookies.set('admin_session', token, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7 });
      
      return Astro.redirect('/admin');
    } else {
      // Regular login
      const [user] = await db.select().from(users).where(eq(users.email, email)).limit(1);
      
      if (!user) {
        errorMessage = 'Invalid email or password';
      } else {
        const isValid = await verifyPassword(password, user.passwordHash);
        if (isValid) {
          const token = await createSessionCookie(user.id);
          Astro.cookies.set('admin_session', token, { path: '/', httpOnly: true, secure: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7 });
          return Astro.redirect('/admin');
        } else {
          errorMessage = 'Invalid email or password';
        }
      }
    }
  } catch (e: any) {
    errorMessage = e.message || 'An error occurred';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{isFirstSetup ? 'Admin Setup' : 'Admin Login'} - Techily Fly</title>
    <link href="/src/styles/global.css" rel="stylesheet" />
  </head>
  <body class="bg-cloud-surface text-tf-graphite min-h-screen flex items-center justify-center font-sans">
    <div class="w-full max-w-md p-8 bg-white rounded-xl shadow-lg border border-gray-100">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold mb-2">{isFirstSetup ? 'Admin Setup' : 'Admin Login'}</h1>
        <p class="text-gray-500 text-sm">
          {isFirstSetup ? 'Create your first admin account to get started.' : 'Enter your credentials to access the dashboard.'}
        </p>
      </div>

      {errorMessage && (
        <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-lg text-sm border border-red-100">
          {errorMessage}
        </div>
      )}

      <form method="POST" class="space-y-5">
        <div>
          <label for="email" class="block text-sm font-semibold mb-2">Email / Username / Mobile</label>
          <input 
            type="text" 
            id="email" 
            name="email" 
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-signal-coral focus:ring-2 focus:ring-signal-coral/20 outline-none transition-all"
            placeholder="admin@example.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-semibold mb-2">Password</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            required
            class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-signal-coral focus:ring-2 focus:ring-signal-coral/20 outline-none transition-all"
            placeholder="••••••••"
          />
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-tf-graphite hover:bg-black text-white font-semibold rounded-lg transition-colors flex justify-center items-center gap-2"
        >
          {isFirstSetup ? 'Create Account' : 'Sign In'}
        </button>
      </form>
    </div>
  </body>
</html>
