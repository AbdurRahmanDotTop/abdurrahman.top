---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="404 - Page Not Found" currentPath="">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <div class="w-24 h-24 bg-red-50 text-signal-coral rounded-full flex items-center justify-center mb-6">
      <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    
    <h1 class="text-4xl md:text-5xl font-extrabold text-tf-graphite mb-4 tracking-tight">
      Page Not Found
    </h1>
    
    <p class="text-gray-500 font-medium max-w-md mx-auto mb-8 text-lg">
      The admin page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
    </p>

    <a href="/admin" class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold text-white bg-tf-graphite rounded-xl hover:bg-signal-coral transition-colors shadow-lg shadow-black/10">
      <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Dashboard
    </a>
  </div>
</AdminLayout>
