---
export const prerender = false;

import { eq, desc } from 'drizzle-orm';
import { getDb } from '../../db';
import { inquiries } from '../../db/schema';

const locals = Astro.locals as any;
const env = locals.runtime?.env;
import AdminLayout from '../../layouts/AdminLayout.astro';

const db = getDb(env.DB);

let message = '';

// Handle mark as read/unread or delete
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');
    const id = data.get('id') as string;

    if (id && action === 'toggle_status') {
      const currentStatus = data.get('currentStatus') as string;
      const newStatus = currentStatus === 'unread' ? 'read' : 'unread';
      await db.update(inquiries).set({ status: newStatus }).where(eq(inquiries.id, id));
      message = `Inquiry marked as ${newStatus}.`;
    } else if (id && action === 'delete') {
      await db.delete(inquiries).where(eq(inquiries.id, id));
      message = 'Inquiry deleted.';
    }
  } catch (e: any) {
    message = e.message || 'Error processing request.';
  }
}

const allInquiries = await db.select().from(inquiries).orderBy(desc(inquiries.createdAt));
---

<AdminLayout title="Client Inquiries" currentPath="/admin/inquiries">
  <header class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Client Inquiries</h1>
      <p class="text-gray-500 mt-2">View and manage contact form submissions.</p>
    </div>
  </header>

  {message && <div class="mb-6 p-4 bg-blue-50 text-blue-700 rounded-xl font-medium border border-blue-100">{message}</div>}

  <div class="grid grid-cols-1 gap-6">
    {allInquiries.length === 0 ? (
      <div class="bg-white p-12 text-center rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-400">No inquiries yet</h3>
      </div>
    ) : (
      allInquiries.map((inq) => (
        <div class={`bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all ${inq.status === 'unread' ? 'border-l-4 border-l-signal-coral border-y-gray-100/60 border-r-gray-100/60' : 'border border-gray-100/60'}`}>
          <div class="flex flex-col md:flex-row justify-between gap-4 mb-6">
            <div>
              <h3 class="text-2xl font-bold mb-1">{inq.name}</h3>
              <a href={`mailto:${inq.email}`} class="text-signal-coral hover:underline font-medium flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                {inq.email}
              </a>
            </div>
            <div class="text-left md:text-right">
              <span class="text-sm text-gray-400 font-mono block mb-2">{new Date(inq.createdAt).toLocaleString()}</span>
              <span class={`inline-flex items-center px-2.5 py-1 text-xs font-bold rounded-md uppercase tracking-wider ${inq.status === 'unread' ? 'bg-red-50 text-red-600 border border-red-100' : 'bg-gray-50 text-gray-500 border border-gray-200'}`}>
                {inq.status === 'unread' && <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>}
                {inq.status}
              </span>
            </div>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 text-sm">
            <div class="bg-gray-50/80 p-4 rounded-xl border border-gray-100">
              <span class="block text-gray-400 font-bold mb-1.5 text-[10px] uppercase tracking-wider">Company</span>
              <span class="font-bold text-gray-800">{inq.company || 'N/A'}</span>
            </div>
            <div class="bg-gray-50/80 p-4 rounded-xl border border-gray-100">
              <span class="block text-gray-400 font-bold mb-1.5 text-[10px] uppercase tracking-wider">Project Type</span>
              <span class="font-bold text-gray-800">{inq.projectType || 'N/A'}</span>
            </div>
            <div class="bg-gray-50/80 p-4 rounded-xl border border-gray-100">
              <span class="block text-gray-400 font-bold mb-1.5 text-[10px] uppercase tracking-wider">Budget</span>
              <span class="font-bold text-gray-800">{inq.budget || 'N/A'}</span>
            </div>
            <div class="bg-gray-50/80 p-4 rounded-xl border border-gray-100">
              <span class="block text-gray-400 font-bold mb-1.5 text-[10px] uppercase tracking-wider">Timeline</span>
              <span class="font-bold text-gray-800">{inq.timeline || 'N/A'}</span>
            </div>
          </div>

          <div class="mb-8">
            <h4 class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-3">Message</h4>
            <div class="bg-[#f8fafc] p-5 rounded-xl border border-gray-100">
              <p class="text-gray-700 whitespace-pre-wrap leading-relaxed">{inq.message}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 border-t border-gray-100 pt-6">
            <form method="POST">
              <input type="hidden" name="action" value="toggle_status" />
              <input type="hidden" name="id" value={inq.id} />
              <input type="hidden" name="currentStatus" value={inq.status} />
              <button type="submit" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-tf-graphite text-sm font-bold rounded-xl transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                Mark as {inq.status === 'unread' ? 'Read' : 'Unread'}
              </button>
            </form>

            <form method="POST" onsubmit="return confirm('Are you sure you want to delete this inquiry?');">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={inq.id} />
              <button type="submit" class="px-5 py-2.5 text-red-600 hover:bg-red-50 text-sm font-bold rounded-xl transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Delete
              </button>
            </form>
          </div>
        </div>
      ))
    )}
  </div>
</AdminLayout>
