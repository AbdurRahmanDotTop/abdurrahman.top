---
export const prerender = false;

import { eq, desc } from 'drizzle-orm';
import { getDb } from '../../db';
import { inquiries } from '../../db/schema';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);

let message = '';

// Handle mark as read/unread or delete
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');
    const id = data.get('id') as string;

    if (id && action === 'toggle_status') {
      const currentStatus = data.get('currentStatus') as string;
      const newStatus = currentStatus === 'unread' ? 'read' : 'unread';
      await db.update(inquiries).set({ status: newStatus }).where(eq(inquiries.id, id));
      message = `Inquiry marked as ${newStatus}.`;
    } else if (id && action === 'delete') {
      await db.delete(inquiries).where(eq(inquiries.id, id));
      message = 'Inquiry deleted.';
    }
  } catch (e: any) {
    message = e.message || 'Error processing request.';
  }
}

const allInquiries = await db.select().from(inquiries).orderBy(desc(inquiries.createdAt));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Manage Inquiries - Techily Fly</title>
    <link href="/src/styles/global.css" rel="stylesheet" />
  </head>
  <body class="bg-cloud-surface text-tf-graphite min-h-screen font-sans flex">
    
    <aside class="w-64 bg-tf-graphite text-white min-h-screen flex flex-col">
      <div class="p-6">
        <h2 class="text-2xl font-bold text-signal-coral">Techily Fly</h2>
      </div>
      <nav class="flex-1 px-4 space-y-2">
        <a href="/admin" class="block px-4 py-3 hover:bg-white/5 rounded-lg font-medium transition-colors">Dashboard</a>
        <a href="/admin/inquiries" class="block px-4 py-3 bg-white/10 rounded-lg font-medium transition-colors">Inquiries</a>
        <a href="/admin/sections" class="block px-4 py-3 hover:bg-white/5 rounded-lg font-medium transition-colors">Sections & Pages</a>
        <a href="/admin/blog" class="block px-4 py-3 hover:bg-white/5 rounded-lg font-medium transition-colors">Blog & Articles</a>
        <a href="/admin/settings" class="block px-4 py-3 hover:bg-white/5 rounded-lg font-medium transition-colors">Global Settings</a>
      </nav>
      <div class="p-4">
        <a href="/admin/logout" class="block px-4 py-3 text-red-400 hover:bg-red-400/10 rounded-lg font-medium transition-colors text-center">Logout</a>
      </div>
    </aside>

    <main class="flex-1 p-8 overflow-y-auto h-screen">
      <header class="mb-8 flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold">Client Inquiries</h1>
          <p class="text-gray-500 mt-2">View and manage contact form submissions.</p>
        </div>
      </header>

      {message && <div class="mb-6 p-4 bg-blue-50 text-blue-700 rounded-lg">{message}</div>}

      <div class="grid grid-cols-1 gap-6">
        {allInquiries.length === 0 ? (
          <div class="bg-white p-12 text-center rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-xl font-bold text-gray-400">No inquiries yet</h3>
          </div>
        ) : (
          allInquiries.map((inq) => (
            <div class={`bg-white p-6 rounded-xl shadow-sm border ${inq.status === 'unread' ? 'border-l-4 border-l-signal-coral border-y-gray-100 border-r-gray-100' : 'border-gray-100'}`}>
              <div class="flex flex-col md:flex-row justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-bold">{inq.name}</h3>
                  <a href={`mailto:${inq.email}`} class="text-signal-coral hover:underline font-medium">{inq.email}</a>
                </div>
                <div class="text-right">
                  <span class="text-sm text-gray-400 font-mono">{new Date(inq.createdAt).toLocaleString()}</span>
                  <div class="mt-1">
                    <span class={`inline-block px-2 py-1 text-xs font-bold rounded uppercase tracking-wider ${inq.status === 'unread' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-500'}`}>
                      {inq.status}
                    </span>
                  </div>
                </div>
              </div>
              
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 text-sm">
                <div class="bg-gray-50 p-3 rounded-lg">
                  <span class="block text-gray-400 font-bold mb-1 text-[10px] uppercase">Company</span>
                  <span class="font-medium">{inq.company || 'N/A'}</span>
                </div>
                <div class="bg-gray-50 p-3 rounded-lg">
                  <span class="block text-gray-400 font-bold mb-1 text-[10px] uppercase">Project Type</span>
                  <span class="font-medium">{inq.projectType || 'N/A'}</span>
                </div>
                <div class="bg-gray-50 p-3 rounded-lg">
                  <span class="block text-gray-400 font-bold mb-1 text-[10px] uppercase">Budget</span>
                  <span class="font-medium">{inq.budget || 'N/A'}</span>
                </div>
                <div class="bg-gray-50 p-3 rounded-lg">
                  <span class="block text-gray-400 font-bold mb-1 text-[10px] uppercase">Timeline</span>
                  <span class="font-medium">{inq.timeline || 'N/A'}</span>
                </div>
              </div>

              <div class="mb-6">
                <h4 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-2">Message</h4>
                <p class="text-gray-700 whitespace-pre-wrap leading-relaxed">{inq.message}</p>
              </div>

              <div class="flex gap-4 border-t border-gray-100 pt-4">
                <form method="POST">
                  <input type="hidden" name="action" value="toggle_status" />
                  <input type="hidden" name="id" value={inq.id} />
                  <input type="hidden" name="currentStatus" value={inq.status} />
                  <button type="submit" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-tf-graphite text-sm font-bold rounded-lg transition-colors">
                    Mark as {inq.status === 'unread' ? 'Read' : 'Unread'}
                  </button>
                </form>

                <form method="POST" onsubmit="return confirm('Are you sure you want to delete this inquiry?');">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={inq.id} />
                  <button type="submit" class="px-4 py-2 text-red-600 hover:bg-red-50 text-sm font-bold rounded-lg transition-colors">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          ))
        )}
      </div>
    </main>
  </body>
</html>
