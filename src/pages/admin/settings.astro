---
export const prerender = false;

import { eq } from 'drizzle-orm';
import { getDb } from '../../db';
import { siteSettings, users } from '../../db/schema';
import { env } from "cloudflare:workers";
import AdminLayout from '../../layouts/AdminLayout.astro';
import { hashPassword } from '../../lib/auth';

const db = getDb(env.DB);
let message = '';
let messageType = 'success';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'save_metadata') {
      const siteTitle = (data.get('site_title') as string) || '';
      const siteDescription = (data.get('site_description') as string) || '';
      const seoKeywords = (data.get('seo_keywords') as string) || '';
      const customHeadScripts = (data.get('custom_head_scripts') as string) || '';
      const customBodyScripts = (data.get('custom_body_scripts') as string) || '';

      const settingsToSave = [
        { key: 'site_title', value: siteTitle },
        { key: 'site_description', value: siteDescription },
        { key: 'seo_keywords', value: seoKeywords },
        { key: 'custom_head_scripts', value: customHeadScripts },
        { key: 'custom_body_scripts', value: customBodyScripts }
      ];

      for (const setting of settingsToSave) {
        const existing = await db.select().from(siteSettings).where(eq(siteSettings.key, setting.key));
        if (existing.length > 0) {
          await db.update(siteSettings).set({ value: setting.value }).where(eq(siteSettings.key, setting.key));
        } else {
          await db.insert(siteSettings).values({ id: crypto.randomUUID(), key: setting.key, value: setting.value });
        }
      }
      message = 'Global settings saved successfully.';
      messageType = 'success';
      
    } else if (action === 'change_password') {
      const newPassword = data.get('new_password') as string;
      const confirmPassword = data.get('confirm_password') as string;

      if (!newPassword || newPassword !== confirmPassword) {
        throw new Error("Passwords do not match or are empty.");
      }
      if (newPassword.length < 8) {
        throw new Error("Password must be at least 8 characters long.");
      }

      // Assuming there's only one admin user (the first one)
      const existingUsers = await db.select().from(users).limit(1);
      if (existingUsers.length > 0) {
        const passwordHash = await hashPassword(newPassword);
        await db.update(users).set({ passwordHash }).where(eq(users.id, existingUsers[0].id));
        message = 'Admin password changed successfully.';
        messageType = 'success';
      } else {
        throw new Error("No admin user found to update.");
      }
    }
  } catch (e: any) {
    message = e.message || 'Error processing request.';
    messageType = 'error';
  }
}

// Fetch current settings to populate the form
const allSettings = await db.select().from(siteSettings);
const settingsMap = allSettings.reduce((acc, curr) => {
  acc[curr.key] = curr.value;
  return acc;
}, {} as Record<string, string>);

---

<AdminLayout title="Global Settings" currentPath="/admin/settings">
  <header class="mb-8">
    <h1 class="text-3xl font-bold">Global Settings</h1>
    <p class="text-gray-500 mt-2">Manage site-wide metadata, analytics, and security.</p>
  </header>

  {message && (
    <div class={`mb-6 p-4 rounded-xl font-medium border ${messageType === 'success' ? 'bg-green-50 text-green-700 border-green-100' : 'bg-red-50 text-red-700 border-red-100'}`}>
      {message}
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- SEO & Metadata Form -->
    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
        <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-500">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold">SEO & Metadata</h2>
          <p class="text-xs text-gray-500">Control how your site appears on search engines.</p>
        </div>
      </div>

      <form method="POST" class="space-y-5">
        <input type="hidden" name="action" value="save_metadata" />
        
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Site Title</label>
          <input type="text" name="site_title" value={settingsMap['site_title'] || ''} class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all" placeholder="e.g. AbdurRahman - AI Engineer" />
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Site Description</label>
          <textarea name="site_description" rows="3" class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all resize-none" placeholder="Brief description for search results...">{settingsMap['site_description'] || ''}</textarea>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">SEO Keywords</label>
          <input type="text" name="seo_keywords" value={settingsMap['seo_keywords'] || ''} class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all" placeholder="ai, engineer, developer, portfolio" />
        </div>

        <div class="pt-4 border-t border-gray-100">
          <label class="block text-sm font-bold text-gray-700 mb-2">Custom Head Scripts &lt;head&gt;</label>
          <p class="text-xs text-gray-400 mb-2">E.g., Google Analytics, Meta Pixel. Paste the entire &lt;script&gt; tag.</p>
          <textarea name="custom_head_scripts" rows="3" class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all font-mono text-xs">{settingsMap['custom_head_scripts'] || ''}</textarea>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Custom Body Scripts &lt;body&gt;</label>
          <p class="text-xs text-gray-400 mb-2">E.g., Additional chat widgets or body trackers.</p>
          <textarea name="custom_body_scripts" rows="3" class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all font-mono text-xs">{settingsMap['custom_body_scripts'] || ''}</textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-tf-graphite hover:bg-black text-white font-bold rounded-xl transition-all shadow-lg shadow-black/10 mt-2">
          Save Metadata
        </button>
      </form>
    </div>

    <!-- Security Form -->
    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 h-fit">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
        <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center text-red-500">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        </div>
        <div>
          <h2 class="text-xl font-bold">Admin Security</h2>
          <p class="text-xs text-gray-500">Change your dashboard password.</p>
        </div>
      </div>

      <form method="POST" class="space-y-5">
        <input type="hidden" name="action" value="change_password" />
        
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">New Password</label>
          <input type="password" name="new_password" required minlength="8" class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all" placeholder="••••••••" />
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Confirm New Password</label>
          <input type="password" name="confirm_password" required minlength="8" class="w-full px-4 py-3 bg-gray-50 rounded-xl border border-gray-200 focus:bg-white focus:ring-2 focus:ring-signal-coral/20 focus:border-signal-coral outline-none transition-all" placeholder="••••••••" />
        </div>

        <button type="submit" class="w-full py-3.5 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl transition-all shadow-lg shadow-red-500/20 mt-2">
          Update Password
        </button>
      </form>
    </div>

  </div>
</AdminLayout>
