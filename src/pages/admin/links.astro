---
export const prerender = false;

import { eq, desc } from 'drizzle-orm';
import { getDb } from '../../db';
import { socialLinks, siteSettings } from '../../db/schema';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);
let message = '';

// Handle actions
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');

    if (action === 'save_settings') {
      const cvUrl = (data.get('cv_url') as string) || '';
      const contactEmail = (data.get('contact_email') as string) || '';

      // Upsert CV URL
      const cvExists = await db.select().from(siteSettings).where(eq(siteSettings.key, 'cv_url'));
      if (cvExists.length > 0) {
        await db.update(siteSettings).set({ value: cvUrl }).where(eq(siteSettings.key, 'cv_url'));
      } else {
        await db.insert(siteSettings).values({ id: crypto.randomUUID(), key: 'cv_url', value: cvUrl });
      }

      // Upsert Contact Email
      const emailExists = await db.select().from(siteSettings).where(eq(siteSettings.key, 'contact_email'));
      if (emailExists.length > 0) {
        await db.update(siteSettings).set({ value: contactEmail }).where(eq(siteSettings.key, 'contact_email'));
      } else {
        await db.insert(siteSettings).values({ id: crypto.randomUUID(), key: 'contact_email', value: contactEmail });
      }

      message = 'Settings saved successfully.';
    } else if (action === 'add_social') {
      const platform = data.get('platform') as string;
      const url = data.get('url') as string;
      const icon = (data.get('icon') as string) || '';
      const isActive = data.get('isActive') === 'on';
      const showInHero = data.get('showInHero') === 'on';

      if (platform && url) {
        await db.insert(socialLinks).values({
          id: crypto.randomUUID(),
          platform,
          url,
          icon,
          isActive,
          showInHero,
        });
        message = 'Social link added.';
      }
    } else if (action === 'update_social') {
      const id = data.get('id') as string;
      const platform = data.get('platform') as string;
      const url = data.get('url') as string;
      const icon = data.get('icon') as string;
      const isActive = data.get('isActive') === 'on';
      const showInHero = data.get('showInHero') === 'on';

      if (id && platform && url) {
        await db.update(socialLinks).set({
          platform,
          url,
          icon,
          isActive,
          showInHero,
        }).where(eq(socialLinks.id, id));
        message = 'Social link updated.';
      }
    } else if (action === 'delete_social') {
      const id = data.get('id') as string;
      if (id) {
        await db.delete(socialLinks).where(eq(socialLinks.id, id));
        message = 'Social link deleted.';
      }
    }
  } catch (e: any) {
    message = e.message || 'Error processing request.';
  }
}

// Fetch current data
const settingsRecords = await db.select().from(siteSettings);
const settingsMap = Object.fromEntries(settingsRecords.map(s => [s.key, s.value]));
const currentCvUrl = settingsMap['cv_url'] || '';
const currentContactEmail = settingsMap['contact_email'] || 'Contact@AbdurRahman.Top';

let allSocialLinks = await db.select().from(socialLinks).orderBy(desc(socialLinks.id));

// Auto-seed default social links if empty and hasn't been seeded before
if (allSocialLinks.length === 0 && !settingsMap['has_seeded_socials']) {
  await db.insert(socialLinks).values([
    {
      id: crypto.randomUUID(),
      platform: 'LinkedIn',
      url: 'https://linkedin.com/in/abdurrahmandottop',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>',
      isActive: true,
      showInHero: true,
    },
    {
      id: crypto.randomUUID(),
      platform: 'Twitter / X',
      url: 'https://x.com/AbdurRahmanDotT',
      icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
      isActive: true,
      showInHero: true,
    }
  ]);
  await db.insert(siteSettings).values({ id: crypto.randomUUID(), key: 'has_seeded_socials', value: 'true' });
  
  // Re-fetch
  allSocialLinks = await db.select().from(socialLinks).orderBy(desc(socialLinks.id));
}

---

<AdminLayout title="Socials & CV" currentPath="/admin/links">
  <header class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Socials & CV Settings</h1>
      <p class="text-gray-500 mt-2">Manage your Linktree connections, CV download link, and global contact details.</p>
    </div>
  </header>

  {message && <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border border-emerald-100 rounded-xl font-medium">{message}</div>}

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
    
    <!-- Global Settings Form -->
    <div class="bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 h-fit">
      <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        Global Details
      </h3>
      <form method="POST" class="space-y-5">
        <input type="hidden" name="action" value="save_settings" />
        
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">CV Download URL</label>
          <input type="url" name="cv_url" value={currentCvUrl} placeholder="https://drive.google.com/..." class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
          <p class="text-xs text-gray-400 mt-2">Paste a link to your Google Drive PDF or Dropbox file here.</p>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Primary Contact Email</label>
          <input type="email" name="contact_email" value={currentContactEmail} placeholder="hello@abdurrahman.top" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
        </div>

        <button type="submit" class="w-full px-6 py-3 bg-tf-graphite text-white font-bold rounded-xl hover:bg-black transition-colors flex items-center justify-center gap-2 shadow-lg shadow-black/10">
          Save Settings
        </button>
      </form>
    </div>

    <!-- Social Links Form -->
    <div class="bg-white p-6 md:p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60">
      <h3 id="social-form-title" class="text-xl font-bold mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        Add Social Link
      </h3>
      <form id="social-form" method="POST" class="space-y-5">
        <input type="hidden" name="action" value="add_social" />
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Platform Name</label>
            <input type="text" name="platform" placeholder="e.g., LinkedIn" required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">SVG Icon (Optional)</label>
            <input type="text" name="icon" placeholder="<svg>...</svg>" class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-mono text-xs" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-bold text-gray-700 mb-2">Profile URL</label>
          <input type="url" name="url" placeholder="https://linkedin.com/in/..." required class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-signal-coral focus:border-transparent outline-none transition-all font-medium" />
        </div>

        <div class="flex gap-6 pt-2">
          <div class="flex items-center gap-2">
            <input type="checkbox" name="isActive" id="is-active" checked class="w-5 h-5 text-signal-coral rounded focus:ring-signal-coral border-gray-300" />
            <label for="is-active" class="text-sm font-bold text-gray-700 select-none">Active</label>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" name="showInHero" id="show-hero" checked class="w-5 h-5 text-signal-coral rounded focus:ring-signal-coral border-gray-300" />
            <label for="show-hero" class="text-sm font-bold text-gray-700 select-none">Show in Hero</label>
          </div>
        </div>

        <button id="social-submit-btn" type="submit" class="w-full mt-2 px-6 py-3 bg-signal-coral text-white font-bold rounded-xl hover:bg-[#d94a38] transition-colors shadow-lg shadow-signal-coral/20">
          Add Link
        </button>
      </form>
    </div>

  </div>

  <!-- Social Links List -->
  <div class="mt-8">
    <h3 class="text-xl font-bold mb-4">Current Social Links</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {allSocialLinks.length === 0 ? (
        <p class="text-gray-400 text-sm">No social links added yet.</p>
      ) : (
        allSocialLinks.map(link => (
          <div class="bg-white p-5 rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-gray-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              {link.icon ? (
                <div class="w-10 h-10 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-600" set:html={link.icon} />
              ) : (
                <div class="w-10 h-10 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400 font-bold uppercase text-sm">
                  {link.platform.substring(0,2)}
                </div>
              )}
              <div>
                <h4 class="font-bold text-sm text-tf-graphite">{link.platform}</h4>
                <a href={link.url} target="_blank" class="text-xs text-signal-coral hover:underline truncate max-w-[120px] block">{link.url.replace('https://', '')}</a>
              </div>
            </div>
            
            <div class="flex items-center gap-2">
              {link.showInHero && <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-bold rounded uppercase">Hero</span>}
              {!link.isActive && <span class="px-2 py-0.5 bg-gray-100 text-gray-500 text-[10px] font-bold rounded uppercase">Hidden</span>}
              
              <button type="button" class="p-2 text-blue-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors edit-btn" 
                data-id={link.id}
                data-platform={link.platform}
                data-url={link.url}
                data-icon={link.icon || ''}
                data-isactive={link.isActive ? 'true' : 'false'}
                data-showinhero={link.showInHero ? 'true' : 'false'}
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              </button>

              <form method="POST" onsubmit="return confirm('Delete this link?');">
                <input type="hidden" name="action" value="delete_social" />
                <input type="hidden" name="id" value={link.id} />
                <button type="submit" class="p-2 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
              </form>
            </div>
          </div>
        ))
      )}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const editBtns = document.querySelectorAll('.edit-btn');
      const form = document.getElementById('social-form') as HTMLFormElement;
      const actionInput = form?.querySelector('input[name="action"]') as HTMLInputElement;
      const formTitle = document.getElementById('social-form-title');
      const submitBtn = document.getElementById('social-submit-btn');
      
      // Ensure hidden ID input exists
      let idInput = form?.querySelector('input[name="id"]') as HTMLInputElement;
      if (!idInput && form) {
        idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'id';
        form.appendChild(idInput);
      }

      editBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          
          const id = target.dataset.id;
          const platform = target.dataset.platform;
          const url = target.dataset.url;
          const icon = target.dataset.icon;
          const isActive = target.dataset.isactive === 'true';
          const showInHero = target.dataset.showinhero === 'true';

          // Populate form
          (form.querySelector('input[name="platform"]') as HTMLInputElement).value = platform || '';
          (form.querySelector('input[name="url"]') as HTMLInputElement).value = url || '';
          (form.querySelector('input[name="icon"]') as HTMLInputElement).value = icon || '';
          (form.querySelector('input[name="isActive"]') as HTMLInputElement).checked = isActive;
          (form.querySelector('input[name="showInHero"]') as HTMLInputElement).checked = showInHero;
          
          idInput.value = id || '';
          actionInput.value = 'update_social';
          
          // Update UI
          if (formTitle) formTitle.innerHTML = `<svg class="w-5 h-5 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg> Edit Social Link`;
          if (submitBtn) submitBtn.textContent = 'Update Link';
          
          // Scroll to form
          form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });
    });
  </script>
</AdminLayout>
