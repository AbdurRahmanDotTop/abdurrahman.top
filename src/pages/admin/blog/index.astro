---
export const prerender = false;

import { eq, desc } from 'drizzle-orm';
import { getDb } from '../../../db';
import { blogPosts } from '../../../db/schema';
import { env } from "cloudflare:workers";
import AdminLayout from '../../../layouts/AdminLayout.astro';

const db = getDb(env.DB);
let message = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action');
    const id = data.get('id') as string;

    if (id && action === 'delete') {
      await db.delete(blogPosts).where(eq(blogPosts.id, id));
      message = 'Blog post deleted successfully.';
    } else if (id && action === 'toggle_publish') {
      const isPublished = data.get('currentStatus') === 'true';
      await db.update(blogPosts).set({ 
        isPublished: !isPublished,
        publishedAt: !isPublished ? new Date() : null
      }).where(eq(blogPosts.id, id));
      message = `Blog post ${!isPublished ? 'published' : 'unpublished'}.`;
    }
  } catch (e: any) {
    message = e.message || 'Error processing request.';
  }
}

const allPosts = await db.select().from(blogPosts).orderBy(desc(blogPosts.createdAt));
---

<AdminLayout title="Blog & Articles" currentPath="/admin/blog">
  <header class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <h1 class="text-3xl font-bold">Blog & Articles</h1>
      <p class="text-gray-500 mt-2">Manage your blog posts and articles.</p>
    </div>
    <a href="/admin/blog/editor" class="px-6 py-3 bg-tf-graphite hover:bg-black text-white font-bold rounded-xl transition-all shadow-lg shadow-black/10 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
      Add New Post
    </a>
  </header>

  {message && <div class="mb-6 p-4 bg-blue-50 text-blue-700 rounded-xl font-medium border border-blue-100">{message}</div>}

  <div class="bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100/60 overflow-hidden">
    {allPosts.length === 0 ? (
      <div class="p-12 text-center">
        <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-400 mb-2">No posts yet</h3>
        <p class="text-gray-500 text-sm">Create your first blog post to get started.</p>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-gray-50/50 border-b border-gray-100">
              <th class="py-4 px-6 font-bold text-gray-600 text-sm uppercase tracking-wider">Post</th>
              <th class="py-4 px-6 font-bold text-gray-600 text-sm uppercase tracking-wider">Status</th>
              <th class="py-4 px-6 font-bold text-gray-600 text-sm uppercase tracking-wider">Date</th>
              <th class="py-4 px-6 font-bold text-gray-600 text-sm uppercase tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {allPosts.map((post) => (
              <tr class="hover:bg-gray-50/50 transition-colors group">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-4">
                    {post.featuredImage ? (
                      <img src={post.featuredImage} class="w-12 h-12 rounded-lg object-cover" alt={post.title} />
                    ) : (
                      <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center text-gray-400">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                      </div>
                    )}
                    <div>
                      <h4 class="font-bold text-gray-900 group-hover:text-signal-coral transition-colors">{post.title}</h4>
                      <p class="text-xs text-gray-500 mt-1 truncate max-w-xs">{post.excerpt || post.slug}</p>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6">
                  <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${post.isPublished ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-orange-50 text-orange-700 border border-orange-200'}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${post.isPublished ? 'bg-green-500' : 'bg-orange-500'}`}></span>
                    {post.isPublished ? 'Published' : 'Draft'}
                  </span>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 font-medium">
                  {new Date(post.createdAt).toLocaleDateString()}
                </td>
                <td class="py-4 px-6">
                  <div class="flex items-center justify-end gap-2">
                    <a href={`/blog/${post.slug}`} target="_blank" class="p-2 text-gray-400 hover:text-tf-graphite hover:bg-gray-100 rounded-lg transition-all" title="View live">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </a>
                    
                    <a href={`/admin/blog/editor?id=${post.id}`} class="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all" title="Edit">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    </a>

                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this post?');">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={post.id} />
                      <button type="submit" class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>
