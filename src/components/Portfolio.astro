---
import { eq } from 'drizzle-orm';
import { getDb } from '../db';
import { sections } from '../db/schema';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);
const dbSection = await db.select().from(sections).where(eq(sections.sectionId, 'portfolio')).limit(1);

let portfolioData = {
  heading: 'My Works / <span class="text-signal-coral">Portfolio.</span>',
  subheading: "A curated collection of scalable digital products, AI solutions, and engineering projects I have built.",
  items: [] as any[]
};
let isActive = true;

if (dbSection.length > 0) {
  isActive = dbSection[0].isActive ?? true;
  if (dbSection[0].content) {
    try {
      portfolioData = JSON.parse(dbSection[0].content);
    } catch(e) {}
  }
}

const projects = portfolioData.items || [];
---
{isActive && projects.length > 0 && (
<section id="portfolio" class="py-20 lg:py-32 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="mb-12 md:mb-20 text-center md:text-left">
      <h2 class="text-4xl md:text-5xl font-bold text-tf-graphite mb-4 md:mb-6 tracking-tight" set:html={portfolioData.heading}></h2>
      <p class="text-gray-500 text-base md:text-xl font-medium leading-relaxed max-w-2xl" set:html={portfolioData.subheading}></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {projects.map((project: any) => {
        // Split skills into an array, fallback to empty if null/empty
        const skillsArray = project.skills ? project.skills.split(',').map((s: string) => s.trim()).filter(Boolean) : [];
        
        return (
          <div class="bg-white rounded-[1.5rem] overflow-hidden border border-gray-100 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-xl hover:-translate-y-1 transition-all duration-500 group flex flex-col h-full">
            {/* Featured Image */}
            <div class="relative h-56 md:h-64 overflow-hidden bg-gray-50">
              {project.featuredImage ? (
                <img src={project.featuredImage} alt={project.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
              )}
              {/* Overlay Gradient */}
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
            
            <div class="p-6 md:p-8 flex flex-col flex-grow">
              <h3 class="text-xl md:text-2xl font-bold text-tf-graphite mb-3 tracking-tight group-hover:text-signal-coral transition-colors">{project.title}</h3>
              <p class="text-gray-500 leading-relaxed text-sm md:text-base mb-6 flex-grow">{project.description}</p>
              
              {skillsArray.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-8">
                  {skillsArray.map((skill: string) => (
                    <span class="px-3 py-1 text-xs font-semibold bg-gray-100 text-gray-600 rounded-full">{skill}</span>
                  ))}
                </div>
              )}
              
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 w-full py-3 px-6 bg-tf-graphite hover:bg-signal-coral text-white font-bold rounded-xl transition-colors duration-300 text-sm">
                  Visit Live Project
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              )}
            </div>
          </div>
        )
      })}
    </div>
  </div>
</section>
)}
