---
import { eq } from 'drizzle-orm';
import { getDb } from '../db';
import { sections } from '../db/schema';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);
const dbSection = await db.select().from(sections).where(eq(sections.sectionId, 'services')).limit(1);

let servicesData = {
  heading: "Specialized Services.",
  subheading: "Delivering cutting-edge solutions across engineering, AI, and digital growth with an uncompromising focus on quality.",
  items: [] as any[]
};
let isActive = true;

if (dbSection.length > 0) {
  isActive = dbSection[0].isActive ?? true;
  if (dbSection[0].content) {
    try {
      servicesData = JSON.parse(dbSection[0].content);
    } catch(e) {}
  }
}

const services = servicesData.items || [];
---
{isActive && (
<section id="services" class="py-20 lg:py-32 bg-cloud-surface relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="mb-12 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-8 text-center md:text-left">
      <div class="max-w-2xl mx-auto md:mx-0">
        <h2 class="text-4xl md:text-5xl font-bold text-tf-graphite mb-4 md:mb-6 tracking-tight" set:html={servicesData.heading}></h2>
        <p class="text-gray-500 text-base md:text-xl font-medium leading-relaxed" set:html={servicesData.subheading}></p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
      {services.map((service, index) => (
        <div class={`bg-white rounded-[1.5rem] md:rounded-[2rem] p-6 md:p-12 border border-gray-100 hover:border-gray-200 shadow-[0_4px_20px_rgb(0,0,0,0.02)] hover:shadow-xl transition-all duration-500 group relative overflow-hidden ${service.colSpan}`}>
          <div class={`absolute inset-0 ${service.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-700`}></div>
          <div class="relative z-10 h-full flex flex-col justify-between">
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-gray-100 flex items-center justify-center mb-8 md:mb-12 bg-white shadow-sm mx-auto md:mx-0">
              <span set:html={service.icon}></span>
            </div>
            <div class="text-center md:text-left">
              <h3 class="text-xl md:text-2xl font-bold text-tf-graphite mb-3 md:mb-4 tracking-tight group-hover:text-signal-coral transition-colors">{service.title}</h3>
              <p class="text-gray-500 leading-relaxed font-medium text-sm md:text-lg">{service.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
