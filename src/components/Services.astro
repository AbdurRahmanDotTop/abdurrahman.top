---
const services = [
  {
    title: "AI Solutions & Automation",
    description: "Integrate powerful Generative AI models into your business processes. From smart chatbots to automated content pipelines, I build AI-driven features that save time and cut costs.",
    icon: `<svg class="w-8 h-8 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    title: "Web & Mobile App Development",
    description: "End-to-end development for highly scalable web platforms and native Android applications. Focused on secure authentication, modern UI/UX, and robust databases.",
    icon: `<svg class="w-8 h-8 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
  {
    title: "Digital Strategy & SEO",
    description: "Data-driven SEO optimization and digital marketing strategies to help your product reach the right audience, generate leads, and boost organic conversions.",
    icon: `<svg class="w-8 h-8 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`
  }
];
---
<section id="services" class="py-24 bg-cloud-surface relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-tf-graphite mb-4">What I Do</h2>
      <p class="text-gray-500 text-lg">Delivering cutting-edge solutions across engineering, AI, and digital growth.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100 hover:shadow-xl hover:border-signal-coral/30 transition-all group">
          <div class="w-16 h-16 rounded-2xl bg-signal-coral/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform" set:html={service.icon}></div>
          <h3 class="text-xl font-bold text-tf-graphite mb-4">{service.title}</h3>
          <p class="text-gray-500 leading-relaxed text-sm">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
