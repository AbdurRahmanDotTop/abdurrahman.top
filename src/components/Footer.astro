---
import { eq, asc } from 'drizzle-orm';
import { getDb } from '../db';
import { siteSettings, socialLinks, footerLinks } from '../db/schema';
import { env } from 'cloudflare:workers';

let footerLogo = '/logo-dark.png';
let footerDesc = 'Generative AI Engineer, Full-Stack Developer & Founder of Techily Fly.';
let contactEmail = 'Contact@AbdurRahman.Top';
let contactMobile = '';
let contactAddress = '';
let activeSocials: any[] = [];
let allImportantLinks: any[] = [];

try {
  const db = getDb(env.DB);
  
  // 1. Fetch settings (Logo, Desc, Email, Mobile, Address)
  const settingsDb = await db.select().from(siteSettings);
  const settingsMap = settingsDb.reduce((acc, curr) => {
    acc[curr.key] = curr.value;
    return acc;
  }, {} as Record<string, string>);
  
  if (settingsMap['footer_logo']) footerLogo = settingsMap['footer_logo'];
  if (settingsMap['footer_desc']) footerDesc = settingsMap['footer_desc'];
  if (settingsMap['contact_email']) contactEmail = settingsMap['contact_email'];
  if (settingsMap['contact_mobile']) contactMobile = settingsMap['contact_mobile'];
  if (settingsMap['contact_address']) contactAddress = settingsMap['contact_address'];

  // 2. Fetch active social links
  activeSocials = await db.select().from(socialLinks)
    .where(eq(socialLinks.isActive, true));

  // 3. Fetch active footer links (for horizontal list)
  allImportantLinks = await db.select().from(footerLinks)
    .where(eq(footerLinks.isActive, true))
    .orderBy(asc(footerLinks.order));

} catch (e) {
  console.error("Failed to fetch footer data:", e);
}
---

<footer class="bg-white border-t border-gray-100 pt-20 pb-8 mt-32">
  <div class="max-w-6xl mx-auto px-6 flex flex-col items-center">
    
    <!-- Logo & Description -->
    <div class="text-center mb-16">
      <a href="/" class="inline-block mb-6">
        <img src={footerLogo} alt="Footer Logo" class="h-12 w-auto object-contain mx-auto" />
      </a>
      <p class="text-gray-500 text-lg font-medium leading-relaxed max-w-xl mx-auto">
        {footerDesc}
      </p>
    </div>

    <!-- Contact & Socials (Two-column layout on Desktop) -->
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8 mb-16 pb-16 border-b border-gray-100">
      
      <!-- Left: Contact Details -->
      <div class="flex flex-col items-center md:items-start space-y-5 text-center md:text-left">
        <h4 class="font-bold text-tf-graphite text-xs tracking-widest uppercase font-mono mb-2">Get In Touch</h4>
        
        {contactEmail && (
          <a href={`mailto:${contactEmail}`} class="group flex flex-col md:flex-row items-center gap-3 text-gray-500 hover:text-signal-coral transition-colors font-medium">
            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-red-50 group-hover:text-signal-coral transition-colors shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            {contactEmail}
          </a>
        )}
        
        {contactMobile && (
          <a href={`tel:${contactMobile.replace(/\s+/g, '')}`} class="group flex flex-col md:flex-row items-center gap-3 text-gray-500 hover:text-signal-coral transition-colors font-medium">
            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 group-hover:bg-red-50 group-hover:text-signal-coral transition-colors shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            {contactMobile}
          </a>
        )}
        
        {contactAddress && (
          <div class="group flex flex-col md:flex-row items-center gap-3 text-gray-500 font-medium max-w-sm">
            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.242-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            {contactAddress}
          </div>
        )}
      </div>

      <!-- Right: Social Media Icons (Only Icons) -->
      <div class="flex flex-col items-center md:items-end justify-center md:justify-start">
        <h4 class="font-bold text-tf-graphite text-xs tracking-widest uppercase font-mono mb-6">Follow Me</h4>
        <div class="flex flex-wrap items-center justify-center md:justify-end gap-4">
           {activeSocials.map(link => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform} title={link.platform} class="w-12 h-12 rounded-full bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-500 hover:text-white hover:bg-signal-coral hover:border-signal-coral transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-lg hover:shadow-signal-coral/30">
                {link.icon ? (
                  <div class="w-5 h-5" set:html={link.icon} />
                ) : (
                  <span class="font-bold text-xs uppercase tracking-wider">{link.platform.substring(0, 2)}</span>
                )}
              </a>
           ))}
        </div>
      </div>
    </div>

    <!-- Important Links (Horizontal on Desktop, Vertical on Mobile) -->
    {allImportantLinks.length > 0 && (
      <div class="w-full mb-12 flex flex-col md:flex-row flex-wrap items-center justify-center gap-6 md:gap-10 text-center">
        {allImportantLinks.map((link: any) => (
           <a href={link.url} class="text-gray-500 hover:text-signal-coral transition-colors font-semibold tracking-wide text-sm md:text-base">
             {link.title}
           </a>
        ))}
      </div>
    )}

    <!-- Copyright -->
    <div class="w-full flex flex-col md:flex-row justify-between items-center gap-4 text-[13px] text-gray-400 font-semibold mt-4">
      <p>&copy; {new Date().getFullYear()} AbdurRahman Dot Top. All rights reserved.</p>
      <p class="flex items-center gap-1">Designed with <span class="text-signal-coral">&hearts;</span></p>
    </div>
    
  </div>
</footer>
