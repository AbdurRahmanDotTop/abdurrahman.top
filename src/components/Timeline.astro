---
---
<section id="experience" class="py-24 bg-cloud-surface relative overflow-hidden">
  <div class="max-w-container-max mx-auto px-6 md:px-16 w-full flex flex-col md:flex-row gap-8 max-w-7xl">
    
    <div class="flex-1 space-y-24">
      
      <!-- Header Section -->
      <header class="max-w-2xl text-center md:text-left mx-auto md:mx-0">
        <h2 class="text-4xl md:text-5xl font-bold text-tf-graphite mb-4">Professional Trajectory</h2>
        <p class="text-lg text-gray-500">A chronological record of technical roles, academic foundations, and verified credentials within the engineering domain.</p>
      </header>

      <!-- Combined Timeline Section -->
      <section class="relative">
        
        <!-- Central Timeline Line (Desktop) / Left Line (Mobile) -->
        <div class="absolute left-4 md:left-1/2 md:-ml-px top-0 bottom-0 timeline-line"></div>
        
        <div class="space-y-16 relative z-10">
          
          <!-- Timeline Item 1: Experience (Present) -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <!-- Mobile Dot -->
            <div class="absolute left-[11.5px] top-6 milestone-dot md:hidden"></div>
            
            <!-- Left Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 md:text-right pt-4 pb-2 md:pb-0">
              <div class="text-[13px] text-signal-coral font-bold tracking-wider mb-1 uppercase">May 2023 — Present</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Experience</div>
            </div>
            
            <!-- Desktop Dot -->
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot"></div>
            
            <!-- Right Side (Content) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-0 md:pt-4">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-signal-coral/50 hover:shadow-md group-hover:-translate-y-1">
                <h3 class="text-xl font-bold text-tf-graphite mb-1">TechilyFly</h3>
                <p class="text-base text-gray-700 font-medium mb-3">Lead Developer & AI Engineer</p>
                <p class="text-sm text-gray-500 mb-4 leading-relaxed">
                  Leading development of highly scalable web and mobile applications. Responsible for full-stack architecture, automation systems, and integrating generative AI into production environments.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">PHP / Laravel</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">Kotlin / Android</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">Python / AI</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Item 2: Experience (Past) -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-secondary md:hidden"></div>
            
            <!-- Left Side (Content) - Swapped for Desktop -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 pt-0 md:pt-4 order-2 md:order-1">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1 text-left md:text-right">
                <h3 class="text-xl font-bold text-tf-graphite mb-1">IdeaRise.co</h3>
                <p class="text-base text-gray-700 font-medium mb-3">IT / Admin & Digital Marketer</p>
                <p class="text-sm text-gray-500 mb-4 leading-relaxed">
                  Managed daily computer operations, office administration, and supported online advertising, SEO, and website maintenance globally.
                </p>
                <div class="flex flex-wrap gap-2 md:justify-end">
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">IT Admin</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">Digital Marketing</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">SEO</span>
                </div>
              </div>
            </div>
            
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-secondary order-2"></div>
            
            <!-- Right Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-4 pb-2 md:pb-0 order-1 md:order-3">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">Nov 2020 — Mar 2023</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Experience</div>
            </div>
          </div>

          <!-- Timeline Item 3: Experience (Internship) -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-secondary md:hidden"></div>
            
            <!-- Left Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 md:text-right pt-4 pb-2 md:pb-0">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">Mar 2020 — Jun 2020</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Internship</div>
            </div>
            
            <!-- Desktop Dot -->
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-secondary"></div>
            
            <!-- Right Side (Content) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-0 md:pt-4">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1">
                <h3 class="text-xl font-bold text-tf-graphite mb-1">Pixel Track (DigitalDeepak)</h3>
                <p class="text-base text-gray-700 font-medium mb-3">Digital Marketing Intern</p>
                <p class="text-sm text-gray-500 mb-4 leading-relaxed">
                  Managed SEO campaigns, created social media strategies, and optimized paid ads for improved brand visibility and lead generation.
                </p>
                <div class="flex flex-wrap gap-2">
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">Content Marketing</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">Ads</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Item 4: Experience (Internship 2) -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-secondary md:hidden"></div>
            
            <!-- Left Side (Content) - Swapped -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 pt-0 md:pt-4 order-2 md:order-1">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1 text-left md:text-right">
                <h3 class="text-xl font-bold text-tf-graphite mb-1">Idea Rise Technologies</h3>
                <p class="text-base text-gray-700 font-medium mb-3">Front End Developer Intern</p>
                <p class="text-sm text-gray-500 mb-4 leading-relaxed">
                  Developed responsive websites, optimized user interfaces, fixed layout issues, and collaborated with teams to enhance UX.
                </p>
                <div class="flex flex-wrap gap-2 md:justify-end">
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">HTML / CSS</span>
                  <span class="bg-gray-50 border border-gray-200 text-gray-600 text-xs font-medium px-2 py-1 rounded-md">UI / UX</span>
                </div>
              </div>
            </div>
            
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-secondary order-2"></div>
            
            <!-- Right Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-4 pb-2 md:pb-0 order-1 md:order-3">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">2019 — 2020</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Internship</div>
            </div>
          </div>

          <!-- Section Divider in Timeline -->
          <div class="relative flex justify-center py-12">
            <div class="bg-cloud-surface px-6 z-10 text-[11px] font-bold text-gray-400 tracking-[0.2em] uppercase">ACADEMIC FOUNDATION</div>
            <div class="absolute w-full h-[1px] bg-gray-200 top-1/2"></div>
          </div>

          <!-- Timeline Item 5: Education -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-tertiary md:hidden"></div>
            
            <!-- Left Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 md:text-right pt-4 pb-2 md:pb-0">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">2017 — 2020</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Education</div>
            </div>
            
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-tertiary"></div>
            
            <!-- Right Side (Content) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-0 md:pt-4">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>
                  <h3 class="text-xl font-bold text-tf-graphite">Govt. Polytechnic, Jhajjar</h3>
                </div>
                <p class="text-base text-gray-700 font-medium mb-2">Diploma in Computer Engineering</p>
                <p class="text-sm text-gray-500 leading-relaxed">
                  Specialized in AI, Machine Learning, and Software Engineering. Graduated with First Class Honors (71.16%).
                </p>
              </div>
            </div>
          </div>

          <!-- Timeline Item 6: Education 2 -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-tertiary md:hidden"></div>
            
            <!-- Left Side (Content) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 pt-0 md:pt-4 order-2 md:order-1">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1 text-left md:text-right">
                <div class="flex items-center gap-2 mb-1 md:justify-end">
                  <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  <h3 class="text-xl font-bold text-tf-graphite">Panj-Tech</h3>
                </div>
                <p class="text-base text-gray-700 font-medium mb-2">ADCA</p>
                <p class="text-sm text-gray-500 leading-relaxed">
                  Advanced Diploma in Computer Applications. Achieved Grade: Excellence (84%). Focus on computer fundamentals and core logic.
                </p>
              </div>
            </div>
            
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-tertiary order-2"></div>
            
            <!-- Right Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-4 pb-2 md:pb-0 order-1 md:order-3">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">2016 — 2017</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Certification</div>
            </div>
          </div>
          
          <!-- Timeline Item 7: Education 3 -->
          <div class="relative flex flex-col md:flex-row items-start group">
            <div class="absolute left-[11.5px] top-6 milestone-dot-tertiary md:hidden"></div>
            
            <!-- Left Side (Date/Meta) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-0 md:pr-12 md:text-right pt-4 pb-2 md:pb-0">
              <div class="text-[13px] text-gray-500 font-bold tracking-wider mb-1 uppercase">2015 — 2017</div>
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">Education</div>
            </div>
            
            <div class="hidden md:block absolute left-1/2 -ml-[4.5px] top-6 milestone-dot-tertiary"></div>
            
            <!-- Right Side (Content) -->
            <div class="w-full md:w-1/2 pl-12 md:pl-12 pt-0 md:pt-4">
              <div class="border border-gray-100 bg-white p-6 rounded-xl relative overflow-hidden transition-all duration-300 hover:border-gray-300 hover:shadow-md group-hover:-translate-y-1">
                <div class="flex items-center gap-2 mb-1">
                  <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                  <h3 class="text-xl font-bold text-tf-graphite">BSEB</h3>
                </div>
                <p class="text-base text-gray-700 font-medium mb-2">Matriculation (10th)</p>
                <p class="text-sm text-gray-500 leading-relaxed">
                  Completed with a strong academic foundation in Mathematics, Science, and Computer basics.
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Verified Credentials Section (Bento Grid Style) -->
      <section class="mt-32 border-t border-gray-200 pt-16">
        <header class="mb-12">
          <h2 class="text-2xl font-bold text-tf-graphite mb-2 flex items-center gap-3">
            <svg class="w-7 h-7 text-signal-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            Verified Credentials
          </h2>
          <p class="text-gray-500">Digital records of academic and professional certifications.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Credential Card 1 -->
          <div class="border border-gray-200 bg-white rounded-xl p-6 flex flex-col h-full group hover:border-signal-coral/50 hover:shadow-md transition-all">
            <div class="flex justify-between items-start mb-6">
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">DIPLOMA</div>
              <svg class="w-6 h-6 text-gray-300 group-hover:text-signal-coral transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div class="flex-grow">
              <h4 class="text-lg font-bold text-tf-graphite mb-1">Computer Engineering Diploma</h4>
              <p class="text-sm text-gray-500">Govt Polytechnic, Jhajjar</p>
            </div>
            <div class="mt-8 pt-4 border-t border-gray-100 flex justify-between items-center">
              <span class="text-xs text-gray-400 font-mono">Issued: 2020</span>
              <!-- Optionally link to a specific credential page or modal -->
              <span class="text-[11px] text-signal-coral font-bold tracking-widest hover:text-[#E66A4F] transition-colors cursor-pointer">VIEW RECORD</span>
            </div>
          </div>

          <!-- Credential Card 2 -->
          <div class="border border-gray-200 bg-white rounded-xl p-6 flex flex-col h-full group hover:border-signal-coral/50 hover:shadow-md transition-all">
            <div class="flex justify-between items-start mb-6">
              <div class="text-[11px] text-gray-400 font-bold tracking-[0.1em] uppercase">CERTIFICATE</div>
              <svg class="w-6 h-6 text-gray-300 group-hover:text-signal-coral transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
            </div>
            <div class="flex-grow">
              <h4 class="text-lg font-bold text-tf-graphite mb-1">Advanced Diploma in Computer Applications</h4>
              <p class="text-sm text-gray-500">Panj-Tech Education</p>
            </div>
            <div class="mt-8 pt-4 border-t border-gray-100 flex justify-between items-center">
              <span class="text-xs text-gray-400 font-mono">Issued: 2017</span>
              <span class="text-[11px] text-signal-coral font-bold tracking-widest hover:text-[#E66A4F] transition-colors cursor-pointer">VIEW RECORD</span>
            </div>
          </div>
          
        </div>
      </section>

    </div>
  </div>
</section>

<style>
  .timeline-line {
      width: 1px;
      background: linear-gradient(to bottom, transparent, rgba(50, 50, 50, 0.15), rgba(50, 50, 50, 0.15), transparent);
  }

  .milestone-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background-color: #F15A3B; /* signal-coral */
      box-shadow: 0 0 0 4px #fafafa; /* cloud-surface */
  }
  
  .milestone-dot-secondary {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background-color: #9CA3AF; /* gray-400 */
      box-shadow: 0 0 0 4px #fafafa;
  }
  
  .milestone-dot-tertiary {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background-color: #D1D5DB; /* gray-300 */
      box-shadow: 0 0 0 4px #fafafa;
  }
</style>
