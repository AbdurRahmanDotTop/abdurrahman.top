---
---
<section id="experience" class="py-32 bg-cloud-surface relative overflow-hidden border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
    
    <!-- Left Column: Header -->
    <div class="lg:col-span-4">
      <div class="sticky top-32">
        <h2 class="text-4xl md:text-5xl font-bold text-tf-graphite mb-6 tracking-tight">Experience & <br />Education.</h2>
        <p class="text-gray-500 text-lg font-medium leading-relaxed">A chronological record of technical roles, academic foundations, and verified credentials.</p>
      </div>
    </div>

    <!-- Right Column: Timeline List -->
    <div class="lg:col-span-8 space-y-24">
      
      <!-- Experience Block -->
      <div>
        <h3 class="text-xs font-mono tracking-widest uppercase text-gray-400 font-bold border-b border-gray-200 pb-4 mb-12">Professional Experience</h3>
        
        <div class="space-y-16">
          <!-- Item 1 -->
          <div class="group relative flex flex-col md:flex-row md:items-start gap-4 md:gap-8 transition-all">
            <div class="md:w-1/3 shrink-0 pt-1">
              <p class="text-sm font-bold text-tf-graphite">May 2023 — Present</p>
              <p class="text-[11px] text-gray-400 font-mono uppercase tracking-widest mt-1">Experience</p>
            </div>
            <div class="md:w-2/3">
              <h4 class="text-2xl font-bold text-tf-graphite mb-2 group-hover:text-signal-coral transition-colors">Techily Fly</h4>
              <p class="text-lg text-gray-700 font-semibold mb-4">Lead Developer & AI Engineer</p>
              <p class="text-gray-500 leading-relaxed font-medium mb-6">
                Leading development of highly scalable web and mobile applications. Responsible for full-stack architecture, automation systems, and integrating generative AI into production environments.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="px-3 py-1 bg-white border border-gray-200 rounded-full text-xs font-semibold text-gray-600">PHP / Laravel</span>
                <span class="px-3 py-1 bg-white border border-gray-200 rounded-full text-xs font-semibold text-gray-600">Kotlin / Android</span>
                <span class="px-3 py-1 bg-white border border-gray-200 rounded-full text-xs font-semibold text-gray-600">Python / AI</span>
              </div>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="group relative flex flex-col md:flex-row md:items-start gap-4 md:gap-8 transition-all">
            <div class="md:w-1/3 shrink-0 pt-1">
              <p class="text-sm font-bold text-tf-graphite">Nov 2020 — Mar 2023</p>
              <p class="text-[11px] text-gray-400 font-mono uppercase tracking-widest mt-1">Experience</p>
            </div>
            <div class="md:w-2/3">
              <h4 class="text-2xl font-bold text-tf-graphite mb-2 group-hover:text-signal-coral transition-colors">IdeaRise.co</h4>
              <p class="text-lg text-gray-700 font-semibold mb-4">IT / Admin & Digital Marketer</p>
              <p class="text-gray-500 leading-relaxed font-medium mb-6">
                Managed daily computer operations, office administration, and supported online advertising, SEO, and website maintenance globally.
              </p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="group relative flex flex-col md:flex-row md:items-start gap-4 md:gap-8 transition-all">
            <div class="md:w-1/3 shrink-0 pt-1">
              <p class="text-sm font-bold text-tf-graphite">Mar 2020 — Jun 2020</p>
              <p class="text-[11px] text-gray-400 font-mono uppercase tracking-widest mt-1">Internship</p>
            </div>
            <div class="md:w-2/3">
              <h4 class="text-2xl font-bold text-tf-graphite mb-2 group-hover:text-signal-coral transition-colors">Pixel Track</h4>
              <p class="text-lg text-gray-700 font-semibold mb-4">Digital Marketing Intern</p>
              <p class="text-gray-500 leading-relaxed font-medium mb-6">
                Managed SEO campaigns, created social media strategies, and optimized paid ads for improved brand visibility.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Education Block -->
      <div>
        <h3 class="text-xs font-mono tracking-widest uppercase text-gray-400 font-bold border-b border-gray-200 pb-4 mb-12">Academic Foundation</h3>
        
        <div class="space-y-16">
          <!-- Item 1 -->
          <div class="group relative flex flex-col md:flex-row md:items-start gap-4 md:gap-8 transition-all">
            <div class="md:w-1/3 shrink-0 pt-1">
              <p class="text-sm font-bold text-tf-graphite">2017 — 2020</p>
              <p class="text-[11px] text-gray-400 font-mono uppercase tracking-widest mt-1">Diploma</p>
            </div>
            <div class="md:w-2/3">
              <h4 class="text-xl font-bold text-tf-graphite mb-2">Govt. Polytechnic, Jhajjar</h4>
              <p class="text-base text-gray-700 font-semibold mb-2">Computer Engineering</p>
              <p class="text-gray-500 leading-relaxed font-medium">Specialized in AI, Machine Learning, and Software Engineering. Graduated with First Class Honors (71.16%).</p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="group relative flex flex-col md:flex-row md:items-start gap-4 md:gap-8 transition-all">
            <div class="md:w-1/3 shrink-0 pt-1">
              <p class="text-sm font-bold text-tf-graphite">2016 — 2017</p>
              <p class="text-[11px] text-gray-400 font-mono uppercase tracking-widest mt-1">Certification</p>
            </div>
            <div class="md:w-2/3">
              <h4 class="text-xl font-bold text-tf-graphite mb-2">Panj-Tech Education</h4>
              <p class="text-base text-gray-700 font-semibold mb-2">Advanced Diploma in Computer Applications</p>
              <p class="text-gray-500 leading-relaxed font-medium">Achieved Grade: Excellence (84%). Focus on computer fundamentals and core logic.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
