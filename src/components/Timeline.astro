---
---
<section id="experience" class="py-24 bg-cloud-surface relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-tf-graphite mb-4">Professional Journey</h2>
      <p class="text-gray-500 text-lg">My timeline of experience, education, and milestones</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- Experience Column -->
      <div>
        <h3 class="text-2xl font-bold text-tf-graphite mb-8 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-signal-coral">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          Experience
        </h3>
        
        <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent lg:before:ml-5 lg:before:translate-x-px">
          
          <!-- Experience 1 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-signal-coral rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-signal-coral mb-1 block">May 2023 - Present</span>
              <h4 class="text-lg font-bold text-tf-graphite">Lead Developer & AI Engineer</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">TechilyFly.com • Remote</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Leading development of intelligent web and mobile platforms using PHP/MySQL, Kotlin/Android, and Python AI. Specialized in full stack development, Android app solutions, automation systems, and scalable business platforms.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">PHP/Laravel</span>
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">Kotlin/Android</span>
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">Python AI</span>
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">React/Next.js</span>
              </div>
            </div>
          </div>

          <!-- Experience 2 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-300 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">Nov 2020 - Mar 2023</span>
              <h4 class="text-lg font-bold text-tf-graphite">Computer Operator & IT / Admin</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">IdeaRise.co • India</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Managed daily computer operations, data entry, office administration, and IT activities. Supported digital marketing, online advertising, and website maintenance globally.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">IT Administration</span>
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">Digital Marketing</span>
                <span class="px-2.5 py-1 bg-gray-50 text-xs font-medium text-gray-600 rounded-md border border-gray-200">SEO & Ads</span>
              </div>
            </div>
          </div>

          <!-- Experience 3 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-300 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">Mar 2020 - Jun 2020</span>
              <h4 class="text-lg font-bold text-tf-graphite">Digital Marketing Intern</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">Pixel Track Digital (DigitalDeepak) • Remote</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Managed SEO campaigns, created social media strategies, optimized paid ads, and analyzed performance metrics to improve brand visibility and lead generation.
              </p>
            </div>
          </div>

          <!-- Experience 4 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-300 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">2019 - 2020</span>
              <h4 class="text-lg font-bold text-tf-graphite">Front End Developer Intern</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">IdeaRise Technologies • India</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Developed responsive websites, optimized user interfaces, fixed layout issues, and collaborated with teams to enhance website performance and UX.
              </p>
            </div>
          </div>
          
        </div>
      </div>
      
      <!-- Education Column -->
      <div id="education">
        <h3 class="text-2xl font-bold text-tf-graphite mb-8 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white shadow-sm flex items-center justify-center text-signal-coral">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>
          </div>
          Education
        </h3>
        
        <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent lg:before:ml-5 lg:before:translate-x-px">
          
          <!-- Education 1 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-600 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">2017 - 2020</span>
              <h4 class="text-lg font-bold text-tf-graphite">Diploma in Computer Engineering</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">Govt. Polytechnic, Jhajjar (HSBTE) • Haryana, India</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Specialized in Artificial Intelligence, Machine Learning, and Software Engineering. Graduated with First Class Honors (71.16%). Led multiple student projects in AI and web & app development.
              </p>
            </div>
          </div>

          <!-- Education 2 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-600 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">2016 - 2017</span>
              <h4 class="text-lg font-bold text-tf-graphite">Advanced Diploma in Computer Applications</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">Panj-Tech Education (S.S. Computer Institute) • Bihar, India</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Achieved Grade: Excellence (84%). Focus on computer fundamentals, software applications, and practical implementation.
              </p>
            </div>
          </div>

          <!-- Education 3 -->
          <div class="relative pl-12 lg:pl-14">
            <div class="absolute left-0 lg:left-0 w-10 h-10 bg-white rounded-full border-4 border-cloud-surface shadow flex items-center justify-center">
              <div class="w-3 h-3 bg-gray-600 rounded-full"></div>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
              <span class="text-sm font-bold text-gray-400 mb-1 block">2015 - 2017</span>
              <h4 class="text-lg font-bold text-tf-graphite">Matriculation (10th)</h4>
              <p class="text-sm font-medium text-gray-500 mb-4">Bihar School Examination Board • Patna, India</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Completed with a strong academic foundation in Mathematics, Science, and Computer basics. Developed analytical and problem-solving skills (66%).
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
