---
---
<section id="about" class="py-32 bg-white relative overflow-hidden border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
      
      <!-- Left side: Editorial Image & Details -->
      <div class="lg:col-span-5 space-y-12">
        <div class="relative group">
          <div class="absolute inset-0 bg-signal-coral/5 rounded-3xl -rotate-3 scale-105 transition-transform duration-700 group-hover:rotate-0"></div>
          <!-- Profile image moved from Hero -->
          <img src="https://yt3.googleusercontent.com/fIJ3r6a8JcUGXA7uEIvGopioT1m5VqF_srMy8_xgTAhkeHH4h7qw6yfjHqXfvNf7vsOSeVCy97E=s900-c-k-c0x00ffffff-no-rj" alt="AbdurRahman Md Ghufran" class="relative rounded-3xl w-full h-auto aspect-[4/5] object-cover shadow-2xl shadow-tf-graphite/5" />
          
          <!-- Floating badge -->
          <div class="absolute -bottom-6 -right-6 bg-white p-5 rounded-2xl shadow-xl shadow-tf-graphite/10 border border-gray-100 animate-float">
            <p class="text-[10px] font-mono tracking-widest text-gray-400 uppercase mb-1">Based in</p>
            <p class="text-sm font-bold text-tf-graphite">Bihar, India</p>
          </div>
        </div>
      </div>
      
      <!-- Right side: Typography & Bio -->
      <div class="lg:col-span-7 space-y-12 lg:pt-12">
        <div>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-tf-graphite tracking-tight leading-tight mb-8">
            Transforming Ideas into <br />
            <span class="text-signal-coral">Digital Reality.</span>
          </h2>
          
          <div class="space-y-6 text-gray-500 leading-relaxed text-lg lg:text-xl font-medium">
            <p>
              I am a technologist specializing in Generative AI, full-stack web & app development, and digital marketing. With deep expertise in Python, Kotlin, PHP, and modern web frameworks, I architect solutions that solve real business problems.
            </p>
            <p>
              My approach blends rigorous engineering with intuitive design, ensuring every product is not only robust but also a joy to use.
            </p>
          </div>
        </div>

        <!-- Techily Fly Integration (Bento Box style) -->
        <div class="bg-cloud-surface border border-gray-100 rounded-3xl p-8 md:p-10 relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-64 h-64 bg-signal-coral/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 group-hover:bg-signal-coral/10 transition-colors"></div>
          
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center gap-6 justify-between">
            <div class="space-y-2">
              <div class="inline-flex items-center gap-2 mb-2">
                <span class="px-3 py-1 bg-white border border-gray-200 rounded-full text-[10px] font-bold tracking-widest uppercase text-tf-graphite">Founder</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-tf-graphite">Techily Fly</h3>
              <p class="text-gray-500 font-medium max-w-sm">My technology company, delivering scalable digital platforms and AI automation solutions.</p>
            </div>
            
            <div class="hidden md:block">
              <div class="w-16 h-16 rounded-2xl bg-white border border-gray-100 flex items-center justify-center shadow-sm">
                <img src="/logo-dark.png" alt="Techily Fly Icon" class="w-8 h-8 object-contain" />
              </div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </div>
</section>
