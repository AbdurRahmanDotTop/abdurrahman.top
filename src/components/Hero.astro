---
import { eq, and } from 'drizzle-orm';
import { getDb } from '../db';
import { socialLinks, siteSettings, sections } from '../db/schema';
import { env } from "cloudflare:workers";

const db = getDb(env.DB);

const cvSetting = await db.select().from(siteSettings).where(eq(siteSettings.key, 'cv_url')).limit(1);
const cvUrl = cvSetting.length > 0 ? cvSetting[0].value : '';

const heroLinks = await db.select()
  .from(socialLinks)
  .where(and(eq(socialLinks.isActive, true), eq(socialLinks.showInHero, true)));

// Fetch Hero Content
const heroSectionRows = await db.select().from(sections).where(eq(sections.sectionId, 'hero')).limit(1);
let heroData = {
  heading: "Salaam, I'm <br />\n<span class=\"text-signal-coral\">AbdurRahman.</span>",
  subheading: "A multi-disciplinary <strong class=\"text-tf-graphite font-semibold\">Generative AI Engineer</strong> and <strong class=\"text-tf-graphite font-semibold\">Full-Stack Developer</strong> building intelligent, scalable digital experiences.",
  imageUrl: "",
  videoEmbed: "",
  badge: "Available for new opportunities",
  primaryButtonText: "Explore My Work",
  primaryButtonLink: "#about"
};

if (heroSectionRows.length > 0 && heroSectionRows[0].isActive !== false) {
  try {
    const parsed = JSON.parse(heroSectionRows[0].content || '{}');
    if (parsed.heading) heroData.heading = parsed.heading;
    if (parsed.subheading) heroData.subheading = parsed.subheading;
    if (parsed.imageUrl) heroData.imageUrl = parsed.imageUrl;
    if (parsed.videoEmbed) heroData.videoEmbed = parsed.videoEmbed;
    if (parsed.badge) heroData.badge = parsed.badge;
    if (parsed.primaryButtonText) heroData.primaryButtonText = parsed.primaryButtonText;
    if (parsed.primaryButtonLink) heroData.primaryButtonLink = parsed.primaryButtonLink;
  } catch(e) {}
}
---
<section id="home" class="min-h-[90vh] flex flex-col justify-center pt-24 pb-12 overflow-hidden relative">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-signal-coral/5 via-cloud-surface to-cloud-surface -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 md:px-6 w-full animate-fade-in-up" style="animation-delay: 0.2s;">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-center">
      
      <!-- Text Content -->
      <div class={`space-y-6 md:space-y-8 max-w-2xl ${(heroData.imageUrl || heroData.videoEmbed) ? 'lg:col-span-6 xl:col-span-5' : 'lg:col-span-12'}`}>
        
        {heroData.badge && (
          <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white border border-gray-100 shadow-sm opacity-0-init animate-fade-in-up" style="animation-delay: 0.3s;">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-signal-coral opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-signal-coral"></span>
            </span>
            <span class="text-xs font-mono tracking-widest uppercase text-tf-graphite">{heroData.badge}</span>
          </div>
        )}
        
        <h1 class="font-bold tracking-tighter text-tf-graphite leading-[1.1] opacity-0-init animate-fade-in-up break-words text-[clamp(2.5rem,6vw,4.5rem)] lg:text-[clamp(3.5rem,5vw,5.5rem)]" style="animation-delay: 0.4s;" set:html={heroData.heading}></h1>
        
        <div class="flex flex-col md:flex-row gap-6 md:gap-12 items-start md:items-center opacity-0-init animate-fade-in-up" style="animation-delay: 0.5s;">
          <h2 class="font-medium text-gray-500 max-w-xl leading-relaxed text-[clamp(1.125rem,2.5vw,1.5rem)] lg:text-[clamp(1.25rem,2vw,1.75rem)]" set:html={heroData.subheading}></h2>
        </div>

        <div class="flex flex-wrap items-center gap-4 md:gap-6 pt-8 opacity-0-init animate-fade-in-up" style="animation-delay: 0.6s;">
          {heroData.primaryButtonText && (
            <a href={heroData.primaryButtonLink} class="px-6 md:px-8 py-3.5 md:py-4 rounded-full bg-tf-graphite text-white font-bold tracking-wide hover:bg-signal-coral transition-all shadow-xl shadow-tf-graphite/10 hover:shadow-signal-coral/20 hover:-translate-y-1 flex items-center gap-2 md:gap-3 text-sm md:text-base">
              {heroData.primaryButtonText}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
            </a>
          )}
          
          {cvUrl && (
            <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="px-6 md:px-8 py-3.5 md:py-4 rounded-full bg-white text-tf-graphite border border-gray-200 font-bold tracking-wide hover:border-signal-coral hover:text-signal-coral transition-all shadow-sm hover:shadow-lg hover:shadow-signal-coral/10 hover:-translate-y-1 flex items-center gap-2 md:gap-3 text-sm md:text-base">
              Download CV
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            </a>
          )}
          
          <div class="flex flex-wrap items-center gap-4 md:gap-6 ml-0 md:ml-4 w-full md:w-auto mt-4 md:mt-0">
            {heroLinks.length > 0 ? (
              heroLinks.map(link => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.platform} class="text-gray-400 hover:text-signal-coral transition-colors group">
                  {link.icon ? (
                    <div class="h-6 w-6 group-hover:scale-110 transition-transform" set:html={link.icon} />
                  ) : (
                    <span class="font-bold text-sm uppercase tracking-wider group-hover:underline">{link.platform}</span>
                  )}
                </a>
              ))
            ) : (
              <>
                <a href="https://linkedin.com/in/abdurrahmandottop" target="_blank" class="text-gray-400 hover:text-signal-coral transition-colors group">
                  <span class="sr-only">LinkedIn</span>
                  <svg class="h-6 w-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
                </a>
                <a href="https://x.com/AbdurRahmanDotT" target="_blank" class="text-gray-400 hover:text-signal-coral transition-colors group">
                  <span class="sr-only">Twitter</span>
                  <svg class="h-6 w-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" /></svg>
                </a>
              </>
            )}
          </div>
        </div>
      </div>
      
      <!-- Media Content (Only shows if imageUrl or videoEmbed exists) -->
      {(heroData.imageUrl || heroData.videoEmbed) && (
        <div class="lg:col-span-6 xl:col-span-7 relative w-full max-w-2xl lg:max-w-none mx-auto opacity-0-init animate-fade-in-up" style="animation-delay: 0.7s;">
          <div class="absolute inset-0 bg-signal-coral/10 rounded-[2rem] md:rounded-[3rem] transform rotate-3 scale-[1.03] -z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-tf-graphite/5 to-transparent rounded-[2rem] md:rounded-[3rem] transform -rotate-2 scale-[1.03] -z-10"></div>
          
          {heroData.videoEmbed ? (
            <div class="w-full rounded-[2rem] md:rounded-[3rem] shadow-2xl border-2 md:border-4 border-white overflow-hidden aspect-video [&>iframe]:w-full [&>iframe]:h-full" set:html={heroData.videoEmbed}></div>
          ) : (
            <img src={heroData.imageUrl} alt="Hero Media" class="w-full h-auto object-cover rounded-[2rem] md:rounded-[3rem] shadow-2xl border-2 md:border-4 border-white" />
          )}
        </div>
      )}
      
    </div>
  </div>
</section>
