---
---
<section id="home" class="min-h-screen flex items-center pt-20 pb-12 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-tf-graphite/5 border border-tf-graphite/10 text-sm font-medium">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-signal-coral opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-signal-coral"></span>
        </span>
        Welcome to My Digital World!
      </div>
      
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-tf-graphite leading-tight">
        Salaam, I'm <br class="hidden md:block"/>
        <span class="text-signal-coral">AbdurRahman</span>
      </h1>
      
      <h2 class="text-xl md:text-2xl font-medium text-gray-600 max-w-xl">
        Generative AI Engineer • Full-Stack Developer • Digital Creator
      </h2>
      
      <p class="text-gray-500 max-w-lg leading-relaxed text-lg">
        Building intelligent solutions with Python, Kotlin, PHP & modern web/app technologies. Passionate about AI, business intelligence, and creating impactful digital experiences.
      </p>
      
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a href="#experience" class="px-6 py-3 rounded-xl bg-signal-coral text-white font-semibold hover:bg-[#E66A4F] transition-colors shadow-lg shadow-signal-coral/30">
          View Experience
        </a>
        <a href="#contact" class="px-6 py-3 rounded-xl bg-white text-tf-graphite border border-gray-200 font-semibold hover:bg-gray-50 transition-colors">
          Get In Touch
        </a>
      </div>

      <div class="flex items-center gap-6 pt-6">
        <a href="https://linkedin.com/in/abdurrahmandottop" target="_blank" class="text-gray-400 hover:text-signal-coral transition-colors">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
        </a>
        <a href="https://x.com/AbdurRahmanDotT" target="_blank" class="text-gray-400 hover:text-signal-coral transition-colors">
          <span class="sr-only">Twitter</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" /></svg>
        </a>
        <a href="https://www.youtube.com/channel/UCrQ9tWwT5vs5Dn4eGRbjnsA?sub_confirmation=1" target="_blank" class="text-gray-400 hover:text-signal-coral transition-colors">
          <span class="sr-only">YouTube</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
    
    <div class="relative mx-auto lg:ml-auto w-full max-w-md">
      <div class="absolute inset-0 bg-gradient-to-tr from-signal-coral/20 to-transparent rounded-full blur-3xl"></div>
      <div class="relative bg-white p-2 rounded-full shadow-2xl shadow-tf-graphite/5 border border-gray-100">
        <img src="https://yt3.googleusercontent.com/fIJ3r6a8JcUGXA7uEIvGopioT1m5VqF_srMy8_xgTAhkeHH4h7qw6yfjHqXfvNf7vsOSeVCy97E=s900-c-k-c0x00ffffff-no-rj" alt="AbdurRahman Md Ghufran" class="w-full h-auto rounded-full object-cover aspect-square" />
      </div>
      
      <!-- Floating Stats Badge -->
      <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-xl shadow-tf-graphite/10 border border-gray-100 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-signal-coral/10 flex items-center justify-center text-signal-coral font-bold text-xl">
          5+
        </div>
        <div>
          <p class="text-sm font-semibold text-tf-graphite">Years</p>
          <p class="text-xs text-gray-500">Experience</p>
        </div>
      </div>
      
      <div class="absolute -top-6 -right-6 bg-white p-4 rounded-2xl shadow-xl shadow-tf-graphite/10 border border-gray-100 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-signal-coral/10 flex items-center justify-center text-signal-coral font-bold text-xl">
          10+
        </div>
        <div>
          <p class="text-sm font-semibold text-tf-graphite">Projects</p>
          <p class="text-xs text-gray-500">Delivered</p>
        </div>
      </div>
    </div>
  </div>
</section>
