---
const skills = [
  {
    category: "Generative AI & Automation",
    items: ["AI API Integration", "Prompt Engineering", "AI-Powered Applications", "Workflow Automation"]
  },
  {
    category: "Full Stack Development",
    items: ["PHP / Laravel", "React / Next.js", "JavaScript / TypeScript", "Tailwind CSS"]
  },
  {
    category: "Mobile App Development",
    items: ["Kotlin", "Android SDK", "REST API Integration", "App Deployment"]
  },
  {
    category: "Database & Cloud",
    items: ["MySQL", "D1 / Cloudflare", "Hostinger", "Git / GitHub"]
  }
];
---
<section id="skills" class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-tf-graphite mb-4">Technical Expertise</h2>
      <p class="text-gray-500 text-lg">A comprehensive look at the tools and technologies I use to build digital solutions.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {skills.map((skillGroup) => (
        <div class="bg-cloud-surface border border-gray-100 rounded-2xl p-6 hover:shadow-lg transition-all hover:-translate-y-1">
          <h3 class="text-lg font-bold text-tf-graphite mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-signal-coral"></span>
            {skillGroup.category}
          </h3>
          <ul class="space-y-3">
            {skillGroup.items.map((item) => (
              <li class="flex items-center gap-2 text-gray-600 text-sm">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
