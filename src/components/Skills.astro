---
const skills = [
  {
    category: "Generative AI",
    items: ["AI API Integration", "Prompt Engineering", "AI-Powered Apps", "Workflow Automation"]
  },
  {
    category: "Full Stack",
    items: ["PHP / Laravel", "React / Next.js", "JavaScript / TS", "Tailwind CSS"]
  },
  {
    category: "Mobile",
    items: ["Kotlin", "Android SDK", "REST APIs", "App Deployment"]
  },
  {
    category: "Infrastructure",
    items: ["MySQL", "D1 / Cloudflare", "Hostinger", "Git / CI/CD"]
  }
];
---
<section id="skills" class="py-32 bg-white relative overflow-hidden border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class="text-4xl md:text-5xl font-bold text-tf-graphite mb-6 tracking-tight">Technical Arsenal.</h2>
        <p class="text-gray-500 text-lg md:text-xl font-medium leading-relaxed">The foundational technologies and frameworks I use to engineer robust digital products.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      {skills.map((skillGroup) => (
        <div class="space-y-6">
          <h3 class="text-sm font-mono tracking-widest uppercase text-tf-graphite font-bold border-b border-gray-100 pb-4">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skillGroup.items.map((item) => (
              <span class="px-4 py-2 bg-cloud-surface hover:bg-white border border-transparent hover:border-gray-200 text-gray-600 hover:text-tf-graphite rounded-full text-[13px] font-semibold transition-all cursor-default">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
